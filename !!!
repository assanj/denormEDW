--1.1. ОСАГО ЗП и экспозиция 20гг-мм.csv
DROP TABLE IF EXISTS actuary.rep_osago_ep_expo;
		CREATE TABLE actuary.rep_osago_ep_expo AS

WITH
aggregated_data AS (
    SELECT 
        -- Группировочные поля
        report_date,
        
        KC,
        DB,
        NEW_REGIONNAME,
        NEW_REGIONNAME_EXT,
        PROPERTYFORMNAME,
        IS_POLICY_FROM_EA,
        IS_POLICY_FROM_E_GARANT,
        IS_NEED_REINSURANCE,
        IS_DEAD_POLICY,
        SALECHANNELFULLNAME_DE,
        contract_type,
        prolongation_type,
        D1_QUARTER,
        D1_MONTH,
        YEAR_QUARTER,
        YEAR_MONTH,
        -- Флаги для фильтрации
        flag_e_osago,
        insured_type_short,
        
        "Федеральный округ",
	    "Флаг Токс_регион",
	    "Регион крупный",

        -- Агрегированные поля:
        SUM(EXPOSURE) as POLICYCOUNT,        
		CASE 
		    WHEN YEAR_MONTH <= TO_CHAR(report_date, 'YYYYMM')  -- если p_report_date 
		    THEN sum(EXPOSURE)
		    ELSE 0 
		END as exposure_sum,

        SUM(EP) as ep_sum,
        SUM(POLICYCOUNT) as policycount_sum,
        SUM(WRITTENPREMIUM) as writtenpremium_sum,
        SUM(RETURNPREMIUM) as returnpremium_sum
    FROM actuary.rep_osago_ep_expo_tmp
    GROUP BY 
        report_date,
        KC,
        DB,
        NEW_REGIONNAME,
        NEW_REGIONNAME_EXT,
        PROPERTYFORMNAME,
        IS_POLICY_FROM_EA,
        IS_POLICY_FROM_E_GARANT,
        IS_NEED_REINSURANCE,
        IS_DEAD_POLICY,
        SALECHANNELFULLNAME_DE,
        contract_type,
        prolongation_type,
        D1_QUARTER,
        D1_MONTH,
        YEAR_QUARTER,
        YEAR_MONTH,
        flag_e_osago,
        insured_type_short,
        "Федеральный округ",
	    "Флаг Токс_регион",
	    "Регион крупный"
)
    SELECT 
        current_timestamp,
        session_user,
        report_date as report_date,

        ad.DB as "База данных",
        ad.NEW_REGIONNAME as "Регион",
        ad.NEW_REGIONNAME_EXT as "Регион ОФР",
        ad.PROPERTYFORMNAME as "Тип страхователя",
        ad.IS_POLICY_FROM_EA,
        ad.IS_POLICY_FROM_E_GARANT,
        ad.IS_NEED_REINSURANCE,
        ad.IS_DEAD_POLICY,
        ad.SALECHANNELFULLNAME_DE as "Канал продаж",
        ad.contract_type as "Признак договора",
        ad.prolongation_type as "Признак пролонгации",
        ad.D1_QUARTER as "Квартал начала",
        ad.D1_MONTH as "Месяц начала",
        ad.YEAR_QUARTER as "Квартал",
        ad.YEAR_MONTH as "Месяц", 

        -- Флаги для финального отбора
	    ad.flag_e_osago as "Флаг Е-ОСАГО",
	    ad.insured_type_short as "Тип страхователя_кр", -- сокращенный тип
        ad.IS_NEED_REINSURANCE as "Передан в пул?",
        
        -- Присоединяем данные из справочника регионов
        "Федеральный округ",
	    "Флаг Токс_регион",
	    "Регион крупный",
       
        ad.exposure_sum as "Экспозиция",  -- kms
        ad.ep_sum as "Заработанная премия",
        ad.policycount_sum as "Количество договоров",
        ad.POLICYCOUNT as "Количество полисолет",  -- как в оригинале
        ad.writtenpremium_sum as "Начисленная премия",
        ad.returnpremium_sum as "Возвраты"
    FROM aggregated_data ad
    WHERE (ad.IS_DEAD_POLICY IS NULL OR ad.IS_DEAD_POLICY = 0 OR ad.IS_DEAD_POLICY = -1);

--get diagnostics v_row_count := ROW_COUNT;
