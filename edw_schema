where NORMAL_NAME is null and
      (
       lower(INSURANT_NAME COLLATE "ru_RU") like '%медиц%' or
       lower(INSURANT_NAME COLLATE "ru_RU") like '%медец%' or
       lower(INSURANT_NAME COLLATE "ru_RU") like '%жизн%'
      );
get diagnostics v_row_count := ROW_COUNT;
PERFORM actuary.logz(p_pack, p_procedure_name, 'updated', 'step04', v_row_count); 


update actuary.MSFO_INNERGROUP_INSURANTS
set NORMAL_NAME = 'ЛегионКом'
where NORMAL_NAME is null and
      lower(INSURANT_NAME COLLATE "ru_RU") like '%легионком%' and
      lower(INSURANT_NAME COLLATE "ru_RU") not like '%легионкомпан%';
get diagnostics v_row_count := ROW_COUNT;
PERFORM actuary.logz(p_pack, p_procedure_name, 'updated', 'step05', v_row_count); 


update actuary.MSFO_INNERGROUP_INSURANTS
set NORMAL_NAME = 'ПАО РГС'
where NORMAL_NAME is null and
      lower(INSURANT_NAME COLLATE "ru_RU") like '%капитал%пере%';
get diagnostics v_row_count := ROW_COUNT;
PERFORM actuary.logz(p_pack, p_procedure_name, 'updated', 'step06', v_row_count); 


update actuary.MSFO_INNERGROUP_INSURANTS
set NORMAL_NAME = 'ПАО РГС'
where NORMAL_NAME is null and
      lower(INSURANT_NAME COLLATE "ru_RU") like '%капитал%страх%';
get diagnostics v_row_count := ROW_COUNT;
PERFORM actuary.logz(p_pack, p_procedure_name, 'updated', 'step07', v_row_count); 


update actuary.MSFO_INNERGROUP_INSURANTS
set NORMAL_NAME = 'ПАО РГС'
where NORMAL_NAME is null and
