CREATE FUNCTION actuary.util_adm_obj_comm_analizi ()  RETURNS void
  VOLATILE
AS $body$
DECLARE -- 1. Собираем, агрегируем, мэппим и анализируем комментарии к объектам схемы
    -- Author  : MSKAZAKOV
    -- Created : 08.11.2025 07:21:08
    -- v1.3.7
    -- ToDo: Синхронизацию edw-ods, Очистку неактуальных..

/* запуск (анализ->применить):
 
 select actuary.util_adm_obj_comm_analizi();
 -- делаем ручные вставки в поле util_adm_obj_comment.comment_auto(/user)
 select actuary.util_adm_obj_comm_apliki();
 
сохраняемся!
drop table if exists actuary.util_adm_obj_comment_reserve;
       create  table actuary.util_adm_obj_comment_reserve as
	   select * from actuary.util_adm_obj_comment;

 -- архив чистить здесь, если надо: actuary.util_adm_obj_comment_commands_arch

 --*---------------------------------------------------------------------------------
 -- результаты тут:
	select * from actuary.util_adm_obj;
	select * from actuary.util_adm_obj_col;
	select * from actuary.util_adm_obj_comment;

*/

    v_schema_name  TEXT := 'actuary';  ---kms20251108: внутренняя переменная для схемы + необходимо править по коду, если переносить на другую схему
    v_comment_text TEXT;
   
    -- служебные для логов:
    p_pack              varchar := 'util_adm_obj_comm_analizi';
    p_proc              varchar := 'util_adm_obj_comm_analizi';
    v_row_count integer;
   
begin
	PERFORM public.cls();
	SET search_path TO actuary;	
    RAISE NOTICE '=== 1. Начало util_adm_obj_comm_analizi ===';
    
    -- 1. Создаем первую таблицу со всяческими объектами нашей схемы 
           drop table if exists actuary.util_adm_obj;
     CREATE TABLE IF NOT EXISTS actuary.util_adm_obj (
        obj_name TEXT,
        obj_type TEXT,
        obj_location TEXT,
        data_type TEXT,
        is_nullable TEXT,
        schma TEXT,
        obj_hash TEXT,
        user_current TEXT,
        sysmoment TIMESTAMP
    );
    
    -- Комментарии к таблице util_adm_obj
    v_comment_text := 'Таблица всех объектов схемы ' || v_schema_name;
    EXECUTE 'COMMENT ON TABLE actuary.util_adm_obj IS ''' || v_comment_text || '''';
    
    COMMENT ON COLUMN actuary.util_adm_obj.obj_name IS 'Название объекта';
    COMMENT ON COLUMN actuary.util_adm_obj.obj_type IS 'Тип объекта';
    COMMENT ON COLUMN actuary.util_adm_obj.obj_location IS 'Местоположение объекта (таблица для колонок)';
    COMMENT ON COLUMN actuary.util_adm_obj.data_type IS 'Тип данных';
    COMMENT ON COLUMN actuary.util_adm_obj.is_nullable IS 'Разрешение NULL';
    COMMENT ON COLUMN actuary.util_adm_obj.schma IS 'Схема объекта';
    COMMENT ON COLUMN actuary.util_adm_obj.obj_hash IS 'Хэш объекта (schma+obj_name+type)';
    COMMENT ON COLUMN actuary.util_adm_obj.user_current IS 'Пользователь выполнения';
    COMMENT ON COLUMN actuary.util_adm_obj.sysmoment IS 'Временная метка создания';

    -- Заполняем таблицу объектами
    INSERT INTO actuary.util_adm_obj
    WITH all_obj AS (
        -- Таблицы, представления, индексы, последовательности
        SELECT 
            c.relname as obj_name,
            CASE c.relkind
                WHEN 'r' THEN 'TABLE'
                WHEN 'v' THEN 'VIEW'
                WHEN 'm' THEN 'MATERIALIZED_VIEW'
                WHEN 'i' THEN 'INDEX'
                WHEN 'S' THEN 'SEQUENCE'
                WHEN 'c' THEN 'TYPE'
                WHEN 't' THEN 'TOAST_TABLE'
                WHEN 'f' THEN 'FOREIGN_TABLE'
                WHEN 'p' THEN 'PARTITIONED_TABLE'
                ELSE 'OTHER_' || c.relkind
            END as obj_type,
            NULL as obj_location,
            NULL as data_type,
            NULL as is_nullable,
            n.nspname as schma
        FROM pg_class c
        JOIN pg_namespace n ON n.oid = c.relnamespace
        WHERE n.nspname = v_schema_name

        UNION ALL

        -- Столбцы таблиц
        SELECT 
            column_name as obj_name,
            'COLUMN' as obj_type,
            table_name as obj_location,
            data_type as data_type,
            is_nullable as is_nullable,
            table_schema as schma
        FROM information_schema.columns 
        WHERE table_schema = v_schema_name

        UNION ALL

        -- Функции и процедуры
        SELECT 
            p.proname as obj_name,
            CASE 
                WHEN p.prokind = 'f' THEN 'FUNCTION'
                WHEN p.prokind = 'p' THEN 'PROCEDURE'
                WHEN p.prokind = 'a' THEN 'AGGREGATE'
                WHEN p.prokind = 'w' THEN 'WINDOW_FUNCTION'
                ELSE 'FUNCTION_LEGACY'
            END as obj_type,
            NULL as obj_location,
            pg_get_function_result(p.oid) as data_type,
            NULL as is_nullable,
            n.nspname as schma
        FROM pg_proc p
        JOIN pg_namespace n ON n.oid = p.pronamespace
        WHERE n.nspname = v_schema_name

        UNION ALL

        -- Типы данных
        SELECT 
            t.typname as obj_name,
            'TYPE' as obj_type,
            NULL as obj_location,
            CASE 
                WHEN t.typtype = 'b' THEN 'BASE_TYPE'
                WHEN t.typtype = 'c' THEN 'COMPOSITE_TYPE'
                WHEN t.typtype = 'd' THEN 'DOMAIN'
                WHEN t.typtype = 'e' THEN 'ENUM'
                WHEN t.typtype = 'p' THEN 'PSEUDO_TYPE'
                ELSE 'TYPE_' || t.typtype
            END as data_type,
            NULL as is_nullable,
            n.nspname as schma
        FROM pg_type t
        JOIN pg_namespace n ON n.oid = t.typnamespace
        WHERE n.nspname = v_schema_name

        UNION ALL

        -- Сама схема
        SELECT 
            n.nspname as obj_name,
            'schma' as obj_type,
            NULL as obj_location,
            NULL as data_type,
            NULL as is_nullable,
            NULL as schma
        FROM pg_namespace n
        WHERE n.nspname = v_schema_name
    )
    SELECT 
        obj_name,
        CASE 
            WHEN obj_type IN ('TABLE', 'VIEW', 'MATERIALIZED_VIEW', 'COLUMN', 
                               'FUNCTION', 'PROCEDURE', 'SEQUENCE', 'INDEX') 
            THEN obj_type
            ELSE 'OTHERS'
        END as obj_type,
        obj_location,
        data_type,
        is_nullable,
        schma,
        md5(COALESCE(schma, '') || obj_name || obj_type) as obj_hash,
        current_user::text as user_current,
        current_timestamp::timestamp as sysmoment
    FROM all_obj;
    get diagnostics v_row_count := ROW_COUNT; 
        PERFORM actuary.logz(p_pack, p_proc, 'util_adm_obj', 'step01', v_row_count); 

    RAISE NOTICE 'Таблица actuary.util_adm_obj создана, записей: %', (SELECT COUNT(*) FROM actuary.util_adm_obj);
    
    

    -- 2. Создаем вторую таблицу с местами вхождения объектов, экстремально атомарную, корень информации для построения DDL скриптов
           drop table if exists actuary.util_adm_obj_col;
     CREATE TABLE IF NOT EXISTS actuary.util_adm_obj_col (
        obj_name TEXT,
        obj_type TEXT,
        obj_location TEXT,
        obj_location_count INTEGER,
        obj_call TEXT,
        obj_call_sql TEXT,
        obj_call_comment TEXT,
        schma TEXT,
        obj_hash TEXT,
        user_name TEXT,
        sysmoment TIMESTAMP
    );
    
    -- Комментарии к таблице util_adm_obj_col
    v_comment_text := 'Таблица мест вхождения объектов с частотой использования для схемы ' || v_schema_name;
    EXECUTE 'COMMENT ON TABLE actuary.util_adm_obj_col IS ''' || v_comment_text || '''';
    
    COMMENT ON COLUMN actuary.util_adm_obj_col.obj_name IS 'Название объекта';
    COMMENT ON COLUMN actuary.util_adm_obj_col.obj_type IS 'Тип объекта';
    COMMENT ON COLUMN actuary.util_adm_obj_col.obj_location IS 'Места вхождения объекта (без схемы)';
    COMMENT ON COLUMN actuary.util_adm_obj_col.obj_location_count IS 'Количество вхождений объекта';
    COMMENT ON COLUMN actuary.util_adm_obj_col.obj_call IS 'Объекты, которые вызывают данный объект';
    COMMENT ON COLUMN actuary.util_adm_obj_col.obj_call_sql IS 'SQL запрос для поиска вызовов объекта';
    COMMENT ON COLUMN actuary.util_adm_obj_col.obj_call_comment IS 'Комментарий на основе вызовов объекта';
    COMMENT ON COLUMN actuary.util_adm_obj_col.schma IS 'Схема объекта';
    COMMENT ON COLUMN actuary.util_adm_obj_col.obj_hash IS 'Хэш объекта (schma+obj_name+type)';
    COMMENT ON COLUMN actuary.util_adm_obj_col.user_name IS 'Пользователь выполнения';
    COMMENT ON COLUMN actuary.util_adm_obj_col.sysmoment IS 'Временная метка создания';

    -- Заполняем таблицу мест вхождения
    INSERT INTO actuary.util_adm_obj_col
    WITH obj_groups AS (
        SELECT 
            obj_name,
            obj_type,
            string_agg(
                COALESCE(obj_location, obj_name),  -- для COLUMN используем таблицу, для других - само имя
                ', '
            ) as obj_location,
            COUNT(*) as obj_location_count,
            MAX(schma) as schma
        FROM actuary.util_adm_obj
        GROUP BY obj_name, obj_type  ---- здесь сворачиваем
    )
    SELECT 
        obj_name,
        obj_type,
        obj_location,
        obj_location_count,
        NULL as obj_call,  -- заполним отдельно
        NULL as obj_call_sql,  -- заполним отдельно
        NULL as obj_call_comment,  -- заполним отдельно
        schma,
        md5(COALESCE(schma, '') || obj_name || obj_type) as obj_hash,
        current_user::text as user_name,
        current_timestamp::timestamp as sysmoment
    FROM obj_groups
    WHERE obj_type IN ('COLUMN', 'TABLE', 'VIEW', 'FUNCTION', 'PROCEDURE', 'SEQUENCE'); --<<  Режем здесь!

    -- Обновляем поля для объектов, которые могут вызываться другими
    UPDATE actuary.util_adm_obj_col
    SET 
        obj_call = (
            CASE 
                WHEN obj_type IN ('FUNCTION', 'PROCEDURE', 'TABLE', 'VIEW', 'SEQUENCE', 'INDEX') THEN
                    (SELECT string_agg(p.proname, ', ')
                     FROM pg_proc p
                     JOIN pg_namespace n ON p.pronamespace = n.oid
                     WHERE lower(p.prosrc) LIKE lower('%' || v_schema_name ||'.'|| obj_name || '%')
                     AND n.nspname = v_schema_name)
                ELSE NULL
            END
        ),
        obj_call_sql = (
            CASE 
                WHEN obj_type IN ('TABLE', 'VIEW', 'FUNCTION', 'PROCEDURE', 'SEQUENCE', 'INDEX') THEN
                    'SELECT p.proname FROM pg_proc p JOIN pg_namespace n ON p.pronamespace = n.oid WHERE lower(p.prosrc) LIKE lower(''%'  || v_schema_name ||'.'||obj_name || '%'') AND n.nspname = ''' || v_schema_name || ''';'
                WHEN obj_type = 'COLUMN' THEN 
                    'SELECT table_schema, table_name, column_name, data_type FROM information_schema.columns WHERE column_name = ''' || obj_name || ''' AND table_schema = ''' || v_schema_name || ''';'
                WHEN obj_type = 'TYPE' THEN 
                    'SELECT typname, typtype FROM pg_type WHERE typname = ''' || obj_name || ''';'
                ELSE 
                    'SELECT * FROM actuary.util_adm_obj WHERE obj_name = ''' || obj_name || ''';'
            END
        )
    WHERE obj_type IN ('TABLE', 'VIEW', 'FUNCTION', 'PROCEDURE', 'SEQUENCE', 'INDEX', 'COLUMN', 'TYPE', 'OTHERS');
   
        get diagnostics v_row_count := ROW_COUNT; 
        PERFORM actuary.logz(p_pack, p_proc, 'util_adm_obj_col', 'step02', v_row_count); 

    -- Обновляем комментарий на основе obj_call
    UPDATE actuary.util_adm_obj_col
    SET obj_call_comment = (
        CASE 
            WHEN obj_type = 'COLUMN' THEN NULL  -- для COLUMN не заполняем
            WHEN obj_call IS NOT NULL AND obj_call != '' THEN
                CASE obj_type
                    WHEN 'TABLE' THEN 'Таблица "' || obj_name || '" вызывается в: ' || obj_call
                    WHEN 'FUNCTION' THEN 'Функция "' || obj_name || '" вызывается в: ' || obj_call
                    WHEN 'VIEW' THEN 'Представление "' || obj_name || '" вызывается в: ' || obj_call
                    WHEN 'SEQUENCE' THEN 'Последовательность "' || obj_name || '" вызывается в: ' || obj_call
                    WHEN 'INDEX' THEN 'Индекс "' || obj_name || '" вызывается в: ' || obj_call
                    WHEN 'PROCEDURE' THEN 'Процедура "' || obj_name || '" вызывается в: ' || obj_call
                    WHEN 'TYPE' THEN 'Тип "' || obj_name || '" вызывается в: ' || obj_call
                    ELSE 'Объект "' || obj_name || '" типа ' || obj_type || ' вызывается в: ' || obj_call
                END
            ELSE
                CASE obj_type
                    WHEN 'TABLE' THEN 'Таблица "' || obj_name || '" используется в: ' || obj_location
                    WHEN 'FUNCTION' THEN 'Функция "' || obj_name || '" используется в: ' || obj_location
                    WHEN 'VIEW' THEN 'Представление "' || obj_name || '" используется в: ' || obj_location
                    WHEN 'SEQUENCE' THEN 'Последовательность "' || obj_name || '" используется в: ' || obj_location
                    WHEN 'INDEX' THEN 'Индекс "' || obj_name || '" используется в: ' || obj_location
                    WHEN 'PROCEDURE' THEN 'Процедура "' || obj_name || '" используется в: ' || obj_location
                    WHEN 'TYPE' THEN 'Тип "' || obj_name || '" используется в: ' || obj_location
                    ELSE 'Объект "' || obj_name || '" типа ' || obj_type || ' используется в: ' || obj_location
                END
        END
    )
    WHERE obj_type IN ('TABLE', 'VIEW', 'FUNCTION', 'PROCEDURE', 'SEQUENCE', 'INDEX', 'COLUMN', 'TYPE', 'OTHERS');

    RAISE NOTICE 'Таблица actuary.util_adm_obj_col создана, записей: %', (SELECT COUNT(*) FROM actuary.util_adm_obj_col);


    -- 3. Создаем третью таблицу для обновляемых комментариев, её нужно всячески править и наполнять данными, которые нельзя терять (затирать и удалять таблицу)
--    drop table if exists actuary.util_adm_obj_comment;
   -- kms20251108: важно, не затираем данные! если уже создали
   CREATE TABLE IF NOT EXISTS actuary.util_adm_obj_comment (    
				obj_name text NOT NULL, -- Название объекта
