CREATE FUNCTION actuary.guru_cur_rate_by_currcode (policy_currency character varying, cur_date date)  RETURNS numeric
  VOLATILE
AS $body$
DECLARE
Coef NUMERIC;
Max_Cur_Date DATE;
BEGIN
  IF policy_currency in ('RUB', 'RUR') THEN
    Coef := 1;
  ELSE
    select max(CR.EFFECTIVEDATE)
    into Max_Cur_Date
    from ACTUARY.CC_CUR_RATES cr
    where CR.l_en_us = POLICY_CURRENCY
      and CR.EFFECTIVEDATE <= cur_date;
    select CR.CUR
    into Coef
    from ACTUARY.CC_CUR_RATES cr
    where CR.l_en_us = POLICY_CURRENCY and
   		  CR.EFFECTIVEDATE = Max_Cur_Date;
          --CUR_DATE between least(CR.EFFECTIVEDATE,Max_Cur_Date) and least(CR.EXPIREDATE,Max_Cur_Date);
  END IF;
  RETURN Coef; 
END
