     -- main_contract_id,
        osago_chain_number/*,
        is_kasko_with_osago,
        project_code,
        program_code,
        project_name,
        program_name*/
    FROM cdm_analysis_out.ac_osago_form1_h_2604 --_2306 ---------------!!!!!!!!!!!!!!!!!!!!!!!!<<<<<<<<<<<<<<<<<<<<<<<<<<<<
