    get diagnostics v_row_count := ROW_COUNT; 
        PERFORM actuary.logz(p_pack, p_proc, 'util_adm_obj_comment inserted', 'step03', v_row_count); 
    RAISE NOTICE 'Таблица actuary.util_adm_obj_comment inserted, всего записей: %', (SELECT COUNT(*) FROM actuary.util_adm_obj_comment);
  
