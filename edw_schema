drop table if exists actuary.XLS_MSFO_RFS_DAILY;
create table actuary.XLS_MSFO_RFS_DAILY as
--truncate table actuary.XLS_MSFO_RFS_DAILY;
--insert into actuary.XLS_MSFO_RFS_DAILY
select  src.*,
       (4*(to_char(src.RECORD_DATE, 'yyyy')::real - to_char(src.ACCIDENTDATE , 'yyyy')::real ) +
       (ceil(to_char(src.RECORD_DATE, 'mm')::real /3) - ceil(to_char(src.ACCIDENTDATE, 'mm')::real /3)))::integer as DEVELOPMENT_QUARTER
      From (
select
       RFC.DB,
       RFS.CLAIM_ID,
       RFS.MISSED_SUBJECT_ID,
       RFS.LOSS_ADJUSTMENT_ID,
       rfs.NEW_REGIONNAME,
       RFs.PRODUCTCLASS,
       RFs.CLAIM_NUMBER,
       rfs.policy_id,
       RFs.POLICY_SERIES,
       RFs.POLICY_NUMBER,
       RFs.CONTRACT_NUMBER,
       RFs.ACCIDENTDATE,
       RFs.ACCEPTDATE,
       RFS.APPROVEDSUM,
       case
            when (RFS.IS_SUIT = 1 or rfS.is_main = 0) and rfs.MSFO_LINE_OF_BUSINESS IN ('ОСАГО', 'ДАВТО')
            then RFS.CORRECT_RECORD_DATE
            else RFS.RECORD_DATE
        end as RECORD_DATE,
       RFS.RECORD_DATE as BUH_DATE,
       RFs.ACT_CLOSURE_DATE,
       RFS.ACCIDENT_QUARTER,
    -- RFS.DEVELOPMENT_QUARTER,
       RFs.BRANCH_CHAR_ID BRANCH_CODE,
       coalesce(RFS.dict7gs_id, 'нд') as  DICT7GS_ID,
       RFc.PREMIUM_CHARGE_DATE,
       RFs.POLICY_START_DATE,
       RFs.POLICY_END_DATE,
       RFs.CANCEL_DATE,
       RFc.PREMIUM,
       RFc.LIABILITY,
       RFs.SALECHANNEL2008,
       rfs.sale_channel_groupmk_name,
       rfs.is_partner,
       RFs.C_ACCOUNTING_GROUP_ID,
       RFs.INSURANT_NAME,
    -- II.NORMAL_NAME INSURANT_PERIMETR_NAME,
    -- coalesce(II.PERIMETER, 0) PERIMETR,

       RFS.CATEGORY_ID as RGS_CATEGORY_ID,
	   RFS.IS_PVU_FLAG as IS_PVU, --RFC.IS_PVU -- kms16092021
       RFS.IS_SUIT,
       RFS.IS_EXISTS_FIX,
       case when RFC.CATEGORY_ID like 'OSAGO%'
            then -- kms 19102020
              case when RFs.OBJECTCLASS = 'Вред жизни и здоровью' then 'Ответственность (жизнь и здоровье)'
                   when RFs.OBJECTCLASS = 'Вред имуществу' then 'Ответственность (имущество)'
                   else RFs.OBJECTCLASS
              end
            else null
        end OSAGO_OBJECTCLASS,
       rfs.MSFO_RESERVE_GROUP,
       rfs.MSFO_LINE_OF_BUSINESS,
       rfs.is_postingdate_null,
       rfs.is_policy_from_e_garant,
       rfS.is_main,  --kms16092021
       RFS.is_direct_payout_outgo
    -- rfs.tab_from, --kms16092021
    -- rhfs.dwh_date,
    -- CURRENT_TIMESTAMP :: TIMESTAMP As sysmoment
from (select * from cdm_analysis_out.ROL_HISTORY_FOR_SUM_EDW_DAILY
       where  CONTRACT_NUMBER = '1360/19/ФПК-19-270') rfs -->'2021-06-30'
left join
	 (select * from cdm_analysis_out.rol_for_count_daily
		where  CONTRACT_NUMBER = '1360/19/ФПК-19-270') rfc -->'2021-06-30'
on -- RFC.REPORT_DATE = RFS.REPORT_DATE and
 --RHFs.MISSED_SUBJECT_ID = RHFc.MISSED_SUBJECT_ID
   RFC.claim_exposure_id ::text||''  = RFS.claim_exposure_id ::text||''
--left join actuary.DICTSALECHANNELTYPE2008 ch on CH.SALE_CHANNEL_TYPE2008_ID = RFC.SALECHANNEL2008
--left join MSFO_INNERGROUP_INSURANTS ii on II.INSURANT_NAME = RFC.INSURANT_NAME
where 1 = 1
   ) src
;


end if; -- v_ok = 1
exception
when others then
  v_ok := 0;
  PERFORM actuary.logz(p_pack, p_procedure_name, 'SQLERRM: '|| SQLERRM ||', '||'SQLERRM: '|| SQLERRM , 'ERROR', -77777); 
  --raise notice 'SQLSTATE: %', SQLSTATE;
  raise notice 'SQLERRM: %', SQLERRM;
  RAISE;
end;


RETURN v_ok;

EXCEPTION
  WHEN others THEN
  v_ok := 0;
  --raise notice 'SQLSTATE: %', SQLSTATE;
  raise notice 'SQLERRM: %', SQLERRM;
  PERFORM actuary.logz(p_pack, p_procedure_name, 'SQLERRM: '|| SQLERRM ||', '||'SQLERRM: '|| SQLERRM , 'ERROR', -77777); 
  RAISE;
END;
