BEGIN--============================================================================== 1. inner_insurants: ===========================================================================
--==============================================================================================================================================================================
begin
if v_ok = 777 and (lower(p_procedure_name) = lower('inner_insurants') or lower(p_procedure_name) ='all') then

drop table if exists ACTUARY.MSFO_INNERGROUP_INSURANTS;
        create table ACTUARY.MSFO_INNERGROUP_INSURANTS as
select /* full(rfc) parallel(rfc 16) */
       distinct RFC.INSURANT_NAME,
       null::varchar NORMAL_NAME,
       0 PERIMETER
from cdm_analysis_out.ROL_HISTORY_FOR_count_edw rfc
where RFC.REPORT_DATE = p_report_date::date  and 
      --RFC.DB = 'КС' and 
      RFC.PROPERTYFORMNAME != 'Физическое лицо'
  and p_check = 1;
get diagnostics v_row_count := ROW_COUNT;
PERFORM actuary.logz(p_pack, p_procedure_name, 'created', 'step01', v_row_count);   
   
grant select on ACTUARY.MSFO_INNERGROUP_INSURANTS to all_actuary;

update actuary.MSFO_INNERGROUP_INSURANTS
set NORMAL_NAME = null,
    PERIMETER = 0;
get diagnostics v_row_count := ROW_COUNT;
PERFORM actuary.logz(p_pack, p_procedure_name, 'updated', 'step02', v_row_count); 


update actuary.MSFO_INNERGROUP_INSURANTS
