*/
begin
if v_ok = 1 and (lower(p_procedure_name) = 'rep_rol_count_triangle_kasko' or lower(p_procedure_name) = 'all')/**/ then

--REP_ROL_KASKO_COUNT_TRIANGLE
drop table if exists actuary.REP_ROL_COUNT_TRIANGLE_KASKO;
create table actuary.REP_ROL_COUNT_TRIANGLE_KASKO as
select src2.NEW_REGIONNAME,
       src2.CATEGORY_ID,
       src2.CATEGORY_ID_2020,
       src2.IS_PVU,
       src2.CASCA_CLAIM_TYPE,
       'Не суды (не аддитивный!)' as TRIANGLE_TYPE,
       src2.ACCIDENT_QUARTER::integer,
       src2.D1_QUARTER2,
       src2.MIN_APPROVED_QUARTER,
       src2.DEVELOPMENT_QUARTER,
       count(distinct src2.CLAIM_ID) CLAIMS_COUNT,
    -- src2.dwh_date,
       CURRENT_TIMESTAMP :: TIMESTAMP         As sysmoment
from
(
select src1.NEW_REGIONNAME,
       src1.CATEGORY_ID,
       src1.CATEGORY_ID_2020,
       src1.IS_PVU,
       src1.CASCA_CLAIM_TYPE,
       src1.ACCIDENT_QUARTER,
       src1.D1_QUARTER2,
       to_char(src1.MIN_RECORD_1_DATE, 'yyyyq') MIN_APPROVED_QUARTER,
       4*(to_char(src1.MIN_RECORD_1_DATE, 'yyyy')::real - to_char(src1.ACCIDENTDATE , 'yyyy')::real) +
       (ceil(to_char(src1.MIN_RECORD_1_DATE, 'mm')::real/3) - ceil(to_char(src1.ACCIDENTDATE, 'mm')::real/3)) DEVELOPMENT_QUARTER,
       CLAIM_ID
    -- src1.dwh_date
from
(
select -- ordered full(rhfs) full(rhfc) parallel(rhfs 8) parallel(rhfc 8) 
       RHFs.CLAIM_ID,
       RHFs.ACCIDENT_QUARTER,
       RHFs.ACCIDENTDATE,
       RHFs.CATEGORY_ID,
       rhfs.CATEGORY_ID_2020,
       RHFs.NEW_REGIONNAME2025 as NEW_REGIONNAME,
       RHFs.IS_PVU,
       rhfc.CASCA_CLAIM_TYPE,
     -- to_char(RHFs.POLICY_START_DATE, 'yyyyq') D1_QUARTER,
       (to_char(RHFs.LOSSDATE_minus_6months, 'YYYYQ'))::integer as D1_QUARTER2,
       min(RHFS.RECORD_DATE) over (partition by RHFs.CLAIM_ID) MIN_RECORD_1_DATE
     -- rhfs.dwh_date
--from (select * from cdm_analysis_out.ROL_HISTORY_FOR_SUM_EDW_full where tab_from = 'rol_for_sum') rhfs
--join cdm_analysis_out.ROL_HISTORY_FOR_count_EDW rhfc 
     from (select * from cdm_analysis_out.ROL_HISTORY_FOR_SUM_EDW_FULL where REPORT_DATE =  p_report_date::date and tab_from = 'rol_for_sum') rhfs
     join (select * from cdm_analysis_out.ROL_HISTORY_FOR_count_EDW    where REPORT_DATE =  p_report_date::date) rhfc
on RHFC.MISSED_SUBJECT_ID = RHFS.MISSED_SUBJECT_ID and RHFC.REPORT_DATE = RHFS.REPORT_DATE  
where --RHFS.REPORT_DATE = (select max(REPORT_DATE) from actuary.ROL_HISTORY_REPORT_DATES) and
	  --RHFc.REPORT_DATE = (select max(REPORT_DATE) from actuary.ROL_HISTORY_REPORT_DATES) and
      RHFS.CATEGORY_ID IN ('CASCA', 'CASCAFL', 'CASCAUL') and
      RHFc.CATEGORY_ID IN ('CASCA', 'CASCAFL', 'CASCAUL') and
      RHFS.IS_SUIT = 0 and
      RHFS.APPROVEDSUM > 0
  and rhfs.claim_number not like '%2020-DMS%'
  and p_check = 1
) src1
) src2
group by src2.NEW_REGIONNAME,
         src2.CATEGORY_ID,
         src2.CATEGORY_ID_2020,
         src2.IS_PVU,
         src2.CASCA_CLAIM_TYPE,
         src2.ACCIDENT_QUARTER::integer,
         src2.D1_QUARTER2,
         src2.MIN_APPROVED_QUARTER,
         src2.DEVELOPMENT_QUARTER
      -- src2.dwh_date
;

get diagnostics v_row_count := ROW_COUNT;
PERFORM actuary.logz(v_pack_name, 'rep_rol_count_triangle_kasko', 'created', 'step01', v_row_count);

grant select on actuary.REP_ROL_COUNT_TRIANGLE_KASKO to all_actuary;

end if; -- v_ok = 1
exception
when others then
  v_ok := 0;
  raise notice 'SQLSTATE: %', SQLSTATE; raise notice 'SQLERRM: %', SQLERRM;
  PERFORM actuary.logz(v_pack_name, 'rep_rol_count_triangle_kasko', 'SQLSTATE: '|| SQLSTATE||', '||'SQLERRM: '|| SQLERRM , 'exception', -1);
end;


