 -- p_check integer := 1;
begin
get diagnostics v_row_count := ROW_COUNT;
PERFORM actuary.logz(v_pack_name, 'rebuid_objects_ort', 'started', 'step00', v_row_count);
--============================================================================...
if 1=1 then
 
DROP TABLE IF EXISTS actuary.tmp_ccc_claim_policy_4ort;
