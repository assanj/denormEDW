SELECT 
    contract_id,   
    CURRENT_TIMESTAMP::TIMESTAMP AS sysmoment__claim_policy
FROM core.claim_policy
WHERE retired = 0 
  AND period_end = '9999-12-31'::date 
  AND p_check = 1;


 
CREATE INDEX IF NOT EXISTS tmp_ccc_claim_policy_4ort_contract_id_idx ON actuary.tmp_ccc_claim_policy_4ort (contract_id);
ANALYZE actuary.tmp_ccc_claim_policy_4ort;

 
--truncate table actuary.tmp_ac_attrs_policy_opt;
--   insert into actuary.tmp_ac_attrs_policy_opt

drop table if exists actuary.contract_ort_dimensions_is_claim;
create UNLOGGED table actuary.contract_ort_dimensions_is_claim as
select /*HashJoin (ids0 ort)  IndexScan(ids0 ac_attrs_claim_ext_ids_unique) IndexScan(ort contract_ort_dimensions_contract_id_idx)*/
    ort.contract_id,
    ort.risk_object_type_id,
    ort.insured_subject_id,
    ort.contract_series,
    ort.contract_number,
    ort.d1,
    ort.d2,
    ort.dc,
    ort.contract_start_date,
    ort.contract_end_date, 
    ort.dict_7gs_id,
    ort.insurer_type_id,
    ort.category_id,
    ort.category_id_2020,
    ort.c_accounting_group_id,
    ort.form_162_code,
    ort.contract_option_id,
    ort.sale_channel_type_id,
    ort.sale_channel_groupmk_id_2020,
    ort.planning_region_name,
    ort.IS_CAPITAL_INSURANCE,
    ort.is_need_reinsurance, 
    ort.is_partner,
    ort.is_policy_from_ea,
    ort.is_policy_from_e_garant,
    ort.is_exists_claim,
    ort.contract_root_id,
    ort.osago_ter_code,
    ort.insurance_rule,
    ort.accepted_for_reinsurance_main,
    ort.created_timestamp,
    CURRENT_TIMESTAMP::timestamp without time zone AS sysmoment_from_edw
 from cdm_analysis_out.contract_ort_dimensions ort
--inner join core.claim_policy ids0 on ids0.contract_id = ort.contract_id and ids0.retired = 0   AND ids0.period_end = '9999-12-31'::date
  inner join actuary.tmp_ccc_claim_policy_4ort ids0 on ids0.contract_id = ort.contract_id -- and ids0.retired = 0   AND ids0.period_end = '9999-12-31'::date
where p_check = 1
--where is_exists_claim = 1
--where contract_id = 'arm4|3001493120572012d1f3c78ea'
--limit 100
;
ANALYZE actuary.contract_ort_dimensions_is_claim;

drop table if exists actuary.contract_ort_dimensions_is_claim_ext;
create UNLOGGED table actuary.contract_ort_dimensions_is_claim_ext as
select /*HashJoin (ids0 ort)  IndexScan(ids0 ac_attrs_claim_ext_ids_unique) IndexScan(ort contract_ort_dimensions_contract_id_idx)*/
    ort.contract_id,
    ort.risk_object_type_id,
    ort.insured_subject_id,
    ort.contract_series,
    ort.contract_number,
    ort.d1,
    ort.d2,
    ort.dc,
    ort.contract_start_date,
    ort.contract_end_date, 
    ort.dict_7gs_id,
    ort.insurer_type_id,
    ort.category_id,
    ort.category_id_2020,
    ort.c_accounting_group_id,
    ort.form_162_code,


       case ort.CONTRACT_OPTION_ID
            when '1' then '1'
            when '2' then '2'
            when '3' then '1'
            when '4' then '1'
            when '5' then '1'
            when '6' then '1'
            when '7' then '2'
            when '8' then '1'
       end::varchar	as CONTRACT_OPTION_ID,

       case ort.CONTRACT_OPTION_ID
            when '1' then 'Первоначальный'
            when '2' then 'Возобновлённый'
            when '3' then 'Первоначальный'
            when '4' then 'Первоначальный'
            when '5' then 'Первоначальный'
            when '6' then 'Первоначальный'
            when '7' then 'Возобновлённый'
            when '8' then 'Первоначальный'
       end::varchar as CONTRACT_OPTION,   
    
    ort.sale_channel_type_id,
    ort.sale_channel_groupmk_id_2020,
    rsf.sale_channel_groupmk_name,
    
    ort.planning_region_name,
    ort.IS_CAPITAL_INSURANCE,
    ort.is_need_reinsurance, 
    ort.is_partner,
    ort.is_policy_from_ea,
    ort.is_policy_from_e_garant,
    ort.is_exists_claim,
    ort.contract_root_id,
    ort.osago_ter_code,
    ort.insurance_rule,
    accepted_for_reinsurance_main,
    ort.created_timestamp,
    CURRENT_TIMESTAMP::timestamp without time zone AS sysmoment_from_edw
 from actuary.contract_ort_dimensions_is_claim ort
left join core.ref_sale_channel_groupmk rsf on rsf.sale_channel_groupmk_id = ort.sale_channel_groupmk_id_2020 and rsf.period_end = '9999-12-31'::date;
 
ANALYZE actuary.contract_ort_dimensions_is_claim_ext;

drop  table if exists actuary.contract_ort_dimensions_is_claim_by_contract_id cascade;
create unlogged table actuary.contract_ort_dimensions_is_claim_by_contract_id as
--truncate table actuary.ac_attrs_policy_2;
--insert into actuary.ac_attrs_policy_2
select
   -- substr(contract_id, 1, 4 ) 		 as sys_2,
   -- substr(contract_id, 6, 100) 		 as arm_ekis_policyid,
      contract_id   			 		 as contract_id,
   -- substr(insured_subject_id, 6, 100) as insured_subject_id,
   -->>   insured_subject_id 				 as insured_subject_id_2,
    string_agg(distinct src.insured_subject_id ::varchar, ',') 					as insured_subject_id,

	string_agg(distinct substr(risk_object_type_id, 6, 100)::varchar, ',')		as risk_object_type_id,
	string_agg(distinct src.contract_series::varchar, ',')   					as contract_series,
	string_agg(distinct src.contract_number::varchar, ',')  					as contract_number,
    min(src.d1)																	as d1,
    max(src.d2)																	as d2,
    
    min(src.contract_start_date::date)											as contract_start_date,
    max(src.contract_end_date::date)											as contract_end_date, 
    
	string_agg(distinct src.dict_7gs_id::varchar, ',')							as dict_7gs_id,
    
    string_agg(distinct coalesce(src.category_id, 'нд')::varchar, ',')			as category_id,
    string_agg(distinct coalesce(src.category_id_2020, 'нд')::varchar, ',')		as category_id_2020,
    
  -- string_agg(distinct coalesce(m7gs.category_id, 'нд')::varchar, ',')		as ARM_EKIS_CATEGORY_ID_2,
  --  string_agg(distinct coalesce(m7gs.category_id_2020, 'нд')::varchar, ',')	as ARM_EKIS_CATEGORY_ID_2020_2,
    
    string_agg(distinct src.C_ACCOUNTING_GROUP_ID::varchar, ',')				as C_ACCOUNTING_GROUP_ID, 
    string_agg(distinct src.form_162_code::varchar, ',')						as form_162_code,
    
 	string_agg(distinct src.CONTRACT_OPTION_ID, ',')							as CONTRACT_OPTION_ID,
 	string_agg(distinct src.CONTRACT_OPTION, ',')						    	as CONTRACT_OPTION,  
     
    string_agg(distinct src.sale_channel_type_id::varchar, ',')					as sale_channel_type_id,
    string_agg(distinct src.sale_channel_groupmk_id_2020::varchar, ',')			as sale_channel_groupmk_id_2020,
    string_agg(distinct src.sale_channel_groupmk_name::varchar, ',')			as sale_channel_groupmk_name,


    string_agg(distinct coalesce(src.planning_region_name, 'нд')::varchar, ',')	as planning_region_name,
    
    string_agg(distinct src.IS_CAPITAL_INSURANCE::varchar, ',') 			    as IS_CAPITAL_INSURANCE,
    string_agg(distinct src.is_need_reinsurance::varchar, ',') 					as is_need_reinsurance,
    string_agg(distinct src.is_partner::varchar, ',') 							as is_partner,
    string_agg(distinct src.IS_POLICY_FROM_EA::varchar, ',') 					as IS_POLICY_FROM_EA,
    string_agg(distinct src.IS_POLICY_FROM_E_GARANT::varchar, ',') 				as IS_POLICY_FROM_E_GARANT,
    string_agg(distinct substr(src.contract_root_id, 6, 100)::varchar, ',')		as contract_root_id,
    string_agg(distinct src.osago_ter_code::varchar, ',')						as osago_ter_code,
    string_agg(distinct src.insurance_rule::varchar, ',')						as insurance_rule,
    string_agg(distinct src.accepted_for_reinsurance_main::varchar, ',')		as accepted_for_reinsurance_main,
 --   NULL																		as sys_external_id_2,
  --  NULL													 					as sys_source_2,
 --   string_agg(distinct src.created_timestamp::timestamp::varchar, ',')			as sys_modify_date_2,
    current_timestamp::timestamp              									as SYSMOMENT
from actuary.contract_ort_dimensions_is_claim_ext src
--left join actuary.mr_7gs_instype_cat m7gs on m7gs.DICT7GS_ID = src.dict_7gs_id and m7gs.INS_TYPE::varchar = src.insurer_type_id::varchar
where p_check = 1
group by contract_id;

CREATE unique INDEX IF NOT EXISTS contract_ort_dimensions_is_claim_by_contract_id_idx ON actuary.contract_ort_dimensions_is_claim_by_contract_id (contract_id);
ANALYZE actuary.contract_ort_dimensions_is_claim_by_contract_id;

end if;
raise notice '>> ort @EDW успешно пересобраны по скрипту <<';
end
