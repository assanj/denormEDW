    -- Комментарии к таблице util_adm_obj_comment
    v_comment_text := 'Словарь комментариев к объектам схемы actuary ' || v_schema_name;
    EXECUTE 'COMMENT ON TABLE actuary.util_adm_obj_comment IS ''' || v_comment_text || '''';
    
