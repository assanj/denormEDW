    truncate table actuary.util_adm_obj_comment_commands;
    
    -- Вставляем новые данные для текущего запуска (не указываем obj_order - SERIAL сам заполнит)
    INSERT INTO actuary.util_adm_obj_comment_commands 
        (sysmoment, obj_hash, sql_command, obj_type, obj_name, obj_location/*, comment_existing, should_update*/)
   SELECT 
        current_timestamp ,        
        u.obj_hash,
        CASE  
	          -- по новым объектам ставим как есть, когда заполнен существующий, но нет ни авто ни от человека  -ВОПРОС, что будет если раздел ВКЛЮЧЕНИЯ поменялся?!
	          when COALESCE(u.comment_user, u.comment_auto) is  null  and comment_existing is not null then
	        	                'COMMENT ON COLUMN actuary.' || quote_ident(o.obj_location) || '.' || quote_ident(u.obj_name) || 
                ' IS ' || quote_literal(                    
                        case when substr(u.comment_existing,1,1) = '#' then u.comment_existing else '# '||u.comment_existing end 
						||
                    CASE WHEN u.obj_name != l.obj_call THEN ' <<< '||l.obj_call ELSE '' END
                ) || ';'
	        
            -- Комментарий для ТАБЛИЦ
            WHEN u.obj_type LIKE '%TABLE%' THEN    --- u.comment_existing, сюда нельзя, т.к. начнется рекурсивное добавление #  replace(u.comment_existing, '# ', ''),
                'COMMENT ON TABLE actuary.' || quote_ident(u.obj_name) || 
                ' IS ' || quote_literal(
                    '# '|| COALESCE(u.comment_user, u.comment_auto) ||   
                    CASE WHEN u.obj_name != l.obj_call THEN ' <<< '||l.obj_call ELSE '' END
                ) || ';'
            
            -- Комментарий для КОЛОНОК
            WHEN u.obj_type LIKE '%COLUMN%' THEN 
                'COMMENT ON COLUMN actuary.' || quote_ident(o.obj_location) || '.' || quote_ident(u.obj_name) || 
                ' IS ' || quote_literal(
                    '# '|| COALESCE(u.comment_user, u.comment_auto) ||
                    CASE WHEN u.obj_name != l.obj_call THEN ' <<< '||l.obj_call ELSE '' END
                ) || ';'
            
            -- Комментарий для ФУНКЦИЙ (без параметров)
            WHEN u.obj_type LIKE '%FUNCTION%' THEN 
                'COMMENT ON FUNCTION actuary.' || quote_ident(u.obj_name) || 
                ' IS ' || quote_literal(
                    '# '|| COALESCE(u.comment_user, u.comment_auto) ||
                    CASE WHEN u.obj_name != l.obj_call THEN ' <<< '||l.obj_call ELSE '' END
                ) || ';'
            
            -- Комментарий для ПОСЛЕДОВАТЕЛЬНОСТЕЙ
            WHEN u.obj_type LIKE '%SEQUENCE%' THEN 
                'COMMENT ON SEQUENCE actuary.' || quote_ident(u.obj_name) || 
                ' IS ' || quote_literal(
                    '# '|| COALESCE(u.comment_user, u.comment_auto) ||
                    CASE WHEN u.obj_name != l.obj_call THEN ' <<< '||l.obj_call ELSE '' END
                ) || ';'
            
            -- Комментарий для ИНДЕКСОВ
            WHEN u.obj_type LIKE '%INDEX%' THEN 
                'COMMENT ON INDEX actuary.' || quote_ident(u.obj_name) || 
                ' IS ' || quote_literal(
                    '# '|| COALESCE(u.comment_user, u.comment_auto) ||
                    CASE WHEN u.obj_name != l.obj_call THEN ' <<< '||l.obj_call ELSE '' END
                ) || ';'
            
            -- Другие типы объектов
            ELSE NULL
        END as sql_command,
        u.obj_type,
        u.obj_name,
        o.obj_location as obj_location /*,
        u.comment_existing,                  -- существующий комментарий в БД
        case when  (comment_existing IS NULL OR comment_existing LIKE '#%')
             then true else false
        end as should_update    -- флаг нужно ли обновлять*/
        
    FROM actuary.util_adm_obj_comment u
    JOIN actuary.util_adm_obj_col l ON u.obj_hash = l.obj_hash AND u.obj_type = l.obj_type
    JOIN actuary.util_adm_obj o ON u.obj_hash = o.obj_hash AND u.obj_type = o.obj_type
    WHERE 
      --u.obj_hash IN ( SELECT obj_hash FROM actuary.util_adm_obj_location  WHERE obj_name NOT LIKE '%tmp%') AND   
      --length(COALESCE(u.comment_user, u.comment_auto, '')) > 0 AND              
        u.obj_type IN ('TABLE','COLUMN','FUNCTION','SEQUENCE')
    AND u.obj_location_count > 0;
   
    get diagnostics v_row_count := ROW_COUNT; 
	PERFORM actuary.logz(p_pack, p_proc, 'util_adm_obj_comment_commands', 'step01', v_row_count); 
    RAISE NOTICE 'Таблица actuary.util_adm_obj_comment_commands inserted, всего записей: %', (SELECT COUNT(*) FROM actuary.util_adm_obj_comment_commands);


    -- a. Получаем существующие комментарии для всех объектов ДО текущего запуска
    UPDATE actuary.util_adm_obj_comment_commands t
    SET comment_existing = (
        CASE 
            WHEN t.obj_type = 'TABLE' THEN
                (SELECT description 
                 FROM pg_description 
                 JOIN pg_class ON pg_description.objoid = pg_class.oid 
                 JOIN pg_namespace ON pg_class.relnamespace = pg_namespace.oid 
                 WHERE pg_class.relname = t.obj_name 
                 AND pg_namespace.nspname = v_schema_name
                 AND objsubid = 0)
                 
            WHEN t.obj_type = 'COLUMN' THEN
                (SELECT description 
                 FROM pg_description 
                 JOIN pg_class ON pg_description.objoid = pg_class.oid 
                 JOIN pg_namespace ON pg_class.relnamespace = pg_namespace.oid 
                 JOIN pg_attribute ON pg_description.objoid = pg_attribute.attrelid 
                    AND pg_description.objsubid = pg_attribute.attnum
                 WHERE pg_class.relname = t.obj_location 
                 AND pg_namespace.nspname = v_schema_name
                 AND pg_attribute.attname = t.obj_name)
                 
            WHEN t.obj_type = 'FUNCTION' THEN
                (SELECT description 
                 FROM pg_description 
                 JOIN pg_proc ON pg_description.objoid = pg_proc.oid 
                 JOIN pg_namespace ON pg_proc.pronamespace = pg_namespace.oid 
                 WHERE pg_proc.proname = t.obj_name 
                 AND pg_namespace.nspname = v_schema_name
                 AND objsubid = 0)
                 
            WHEN t.obj_type = 'SEQUENCE' THEN
                (SELECT description 
                 FROM pg_description 
                 JOIN pg_class ON pg_description.objoid = pg_class.oid 
                 JOIN pg_namespace ON pg_class.relnamespace = pg_namespace.oid 
                 WHERE pg_class.relname = t.obj_name 
                 AND pg_namespace.nspname = v_schema_name
                 AND pg_class.relkind = 'S'
                 AND objsubid = 0)
        END
    )
    WHERE t.sysmoment = v_sysmoment;
   
   	get diagnostics v_row_count := ROW_COUNT; 
    RAISE NOTICE 'Таблица actuary.util_adm_obj_comment_commands updated,  записей: %', v_row_count;


    --Помечаем объекты разрешёнными для обновления (комментарий пустой или начинается с '#')
    UPDATE actuary.util_adm_obj_comment_commands 
    SET should_update = true
    WHERE sysmoment = v_sysmoment 
      AND (length(coalesce(comment_existing, '')) < 1 OR comment_existing LIKE '#%');
     
    RAISE NOTICE 'Таблица actuary.util_adm_obj_comment_commands updated=>should_update';
   


     -- на случай, если что-то зациклилось в comment_existing:
	UPDATE actuary.util_adm_obj_comment AS tgt
	SET    comment_existing = (
	        SELECT string_agg(word, ' ' ORDER BY min_ord)
	        FROM (
	            SELECT word, min(ord) AS min_ord
	            FROM unnest(regexp_split_to_array(tgt.comment_existing, '\s+'))
	                 WITH ORDINALITY AS t(word, ord)
	            GROUP BY word
	        ) AS u
	       )
	WHERE  tgt.comment_existing ~ '\m(\w+)\M.*\m\1\M'          -- есть повторы слов
			--  AND  LENGTH(tgt.comment_existing) - LENGTH(REPLACE(tgt.comment_existing, '<', '')) > 3
             ;  
	get diagnostics v_row_count := ROW_COUNT; 
	PERFORM actuary.logz(p_pack, p_proc, 'util_adm_obj_comment unsplit<=comment_existing', 'step03', v_row_count); 
    RAISE NOTICE 'Таблица actuary.util_adm_obj_comment unsplit<=comment_existing,  записей: %', v_row_count;
   
    -- на случай, если что-то зациклилось в comment_auto:
   	UPDATE actuary.util_adm_obj_comment AS tgt
	SET    comment_auto = (
	        SELECT string_agg(word, ' ' ORDER BY min_ord)
	        FROM (
	            SELECT word, min(ord) AS min_ord
	            FROM unnest(regexp_split_to_array(tgt.comment_auto, '\s+'))
	                 WITH ORDINALITY AS t(word, ord)
	            GROUP BY word
	        ) AS u
	       )
	WHERE  tgt.comment_auto ~ '\m(\w+)\M.*\m\1\M'          -- есть повторы слов
			--  AND  LENGTH(tgt.comment_auto) - LENGTH(REPLACE(tgt.comment_existing, '<', '')) > 3
             ;  
	get diagnostics v_row_count := ROW_COUNT; 
	PERFORM actuary.logz(p_pack, p_proc, 'util_adm_obj_comment unsplit<=comment_auto', 'step04', v_row_count); 
    RAISE NOTICE 'Таблица actuary.util_adm_obj_comment unsplit<=comment_auto,  записей: %', v_row_count;


	-- апдейтим исходные данные принудительно НА БУДУЩЕЕ по таблицам, которые без какого либо варианта комментариев:	
	update actuary.util_adm_obj_comment u
	set comment_user = 'Назначение таблицы уточняется'
	where u.obj_type  in ('TABLE')
      and length(COALESCE(u.comment_user, u.comment_auto, u.comment_existing,'')) < 1;
	get diagnostics v_row_count := ROW_COUNT; 
	PERFORM actuary.logz(p_pack, p_proc, 'util_adm_obj_comment по пустым updated<=comment_existing', 'step05', v_row_count); 
    RAISE NOTICE 'Таблица actuary.util_adm_obj_comment по пустым updated<=comment_existing,  записей: %', v_row_count;
    -----
	 
    -- Логируем для дебага
    RAISE NOTICE '=== ДЕБАГ ИНФОРМАЦИЯ ===';
    RAISE NOTICE 'Метка времени запуска: %', v_sysmoment;
    RAISE NOTICE 'Всего объектов в обработке: %', (SELECT COUNT(*) FROM actuary.util_adm_obj_comment_commands WHERE sysmoment = v_sysmoment);
    RAISE NOTICE 'Будут обновлены: %', (SELECT COUNT(*) FROM actuary.util_adm_obj_comment_commands WHERE sysmoment = v_sysmoment AND should_update = true);
    RAISE NOTICE 'Пропущены (не наши комментарии): %', (SELECT COUNT(*) FROM actuary.util_adm_obj_comment_commands WHERE sysmoment = v_sysmoment AND should_update = false);

    -- Выполняем команды комментариев только для помеченных объектов текущего запуска
    SET LOCAL lock_timeout = '5s';
    FOR rec IN 
        SELECT * 
        FROM actuary.util_adm_obj_comment_commands 
        WHERE sysmoment = v_sysmoment AND should_update = true 
        ORDER BY obj_order
    LOOP
        IF rec.sql_command IS NOT NULL THEN
            BEGIN
                RAISE NOTICE '%', rec.sql_command; --'Выполняется: %',
              --RAISE NOTICE 'Старый комментарий: %', rec.comment_existing;
                -- Раскомментируйте следующую строку, когда будете готовы выполнять команды
                 EXECUTE rec.sql_command;--------------------------- <<<<< выполнение
                
                -- Отмечаем как успешно выполненное
                UPDATE actuary.util_adm_obj_comment_commands 
                SET executed = true,
                    error_message = NULL,
                    execution_time = current_timestamp
                WHERE sysmoment = v_sysmoment AND obj_order = rec.obj_order;
                
                RAISE NOTICE '	успех,старый %:', rec.comment_existing;
                
            exception
        	    WHEN lock_not_available THEN
      				RAISE NOTICE 'Таблицы заняты, обновление комментариев пропущено';
      		    	v_error_count := v_error_count + 1;
                    UPDATE actuary.util_adm_obj_comment_commands 
                    SET executed = false,
                        error_message = 'Таблицы заняты, обновление комментариев пропущено',
                        execution_time = current_timestamp
                    WHERE sysmoment = v_sysmoment AND obj_order = rec.obj_order;
                WHEN insufficient_privilege THEN
                    v_error_count := v_error_count + 1;
                    UPDATE actuary.util_adm_obj_comment_commands 
                    SET executed = false,
                        error_message = 'Недостаточно прав для обновления комментария',
                        execution_time = current_timestamp
                    WHERE sysmoment = v_sysmoment AND obj_order = rec.obj_order;
                    
                    RAISE NOTICE 'ОШИБКА ПРАВ: Недостаточно прав для обновления комментария объекта %.%', rec.obj_type, rec.obj_name;
                    
                WHEN OTHERS THEN
                    v_error_count := v_error_count + 1;
                    UPDATE actuary.util_adm_obj_comment_commands 
                    SET executed = false,
                        error_message = SQLERRM,
                        execution_time = current_timestamp
                    WHERE sysmoment = v_sysmoment AND obj_order = rec.obj_order;
                    
                    RAISE NOTICE 'ОШИБКА: % при выполнении: %', SQLERRM, rec.sql_command;
            END;
        END IF;
    END LOOP;
    SET lock_timeout TO DEFAULT;  -- Альтернативный синтаксис

    -- Финальная статистика
    RAISE NOTICE '=== РЕЗУЛЬТАТ ===';
    RAISE NOTICE 'Метка времени выполнения: %', v_sysmoment;
    RAISE NOTICE 'Всего выполнено команд: %', (SELECT COUNT(*) FROM actuary.util_adm_obj_comment_commands WHERE sysmoment = v_sysmoment AND executed = true);
    RAISE NOTICE 'Ошибок выполнения: %', v_error_count;
    RAISE NOTICE 'Данные сохранены в actuary.util_adm_obj_comment_commands с меткой времени: %', v_sysmoment;
    perform actuary.logz(p_pack, p_proc, 'acomplished', 'step06', -777); 



-- b. Получаем существующие комментарии для всех объектов теперь уже ПОСЛЕ текущего запуска, они пойдут в главную таблицу, там с ними можно поработать принудительно
    UPDATE actuary.util_adm_obj_comment_commands t
    SET comment_new = (
        CASE 
            WHEN t.obj_type = 'TABLE' THEN
                (SELECT description 
                 FROM pg_description 
                 JOIN pg_class ON pg_description.objoid = pg_class.oid 
                 JOIN pg_namespace ON pg_class.relnamespace = pg_namespace.oid 
                 WHERE pg_class.relname = t.obj_name 
                 AND pg_namespace.nspname = v_schema_name
                 AND objsubid = 0)
                 
            WHEN t.obj_type = 'COLUMN' THEN
                (SELECT description 
                 FROM pg_description 
                 JOIN pg_class ON pg_description.objoid = pg_class.oid 
                 JOIN pg_namespace ON pg_class.relnamespace = pg_namespace.oid 
                 JOIN pg_attribute ON pg_description.objoid = pg_attribute.attrelid 
                    AND pg_description.objsubid = pg_attribute.attnum
                 WHERE pg_class.relname = t.obj_location 
                 AND pg_namespace.nspname = v_schema_name
                 AND pg_attribute.attname = t.obj_name)
                 
            WHEN t.obj_type = 'FUNCTION' THEN
                (SELECT description 
                 FROM pg_description 
                 JOIN pg_proc ON pg_description.objoid = pg_proc.oid 
                 JOIN pg_namespace ON pg_proc.pronamespace = pg_namespace.oid 
                 WHERE pg_proc.proname = t.obj_name 
                 AND pg_namespace.nspname = v_schema_name
                 AND objsubid = 0)
                 
            WHEN t.obj_type = 'SEQUENCE' THEN
                (SELECT description 
                 FROM pg_description 
                 JOIN pg_class ON pg_description.objoid = pg_class.oid 
                 JOIN pg_namespace ON pg_class.relnamespace = pg_namespace.oid 
                 WHERE pg_class.relname = t.obj_name 
                 AND pg_namespace.nspname = v_schema_name
                 AND pg_class.relkind = 'S'
                 AND objsubid = 0)
        END
    )
    WHERE t.sysmoment = v_sysmoment;
   
   	get diagnostics v_row_count := ROW_COUNT; 
    RAISE NOTICE 'Таблица actuary.util_adm_obj_comment_commands new updated,  записей: %', v_row_count;

  
    -- добавляем рекурсивно (обучаем) варианты, которые уже есть в базе. пройдём по ним только с ледующий раз!
	UPDATE actuary.util_adm_obj_comment u
	SET    comment_existing    = case when length(coalesce(l.comment_new, '')) > 0 then l.comment_new else null end,
	       comment_ddl_last = l.sysmoment
	FROM   actuary.util_adm_obj_comment_commands l
	WHERE  u.obj_hash = l.obj_hash
	  AND  length(coalesce(l.comment_new, '')) > 0
	  AND  l.sysmoment = v_sysmoment
	--AND  length(COALESCE(u.comment_user, u.comment_auto, u.comment_new)) < 1
	 ;
	get diagnostics v_row_count := ROW_COUNT; 
	PERFORM actuary.logz(p_pack, p_proc, 'util_adm_obj_comment updated<=comment_new', 'step02', v_row_count); 
    RAISE NOTICE 'Таблица actuary.util_adm_obj_comment updated<=comment_new,  записей: %', v_row_count;
	-----------------------------------------------------------


    update actuary.util_adm_obj_comment  set  comment_auto  = 'Функция применения комментариев на объекты' where obj_name = 'util_adm_obj_comm_apliki';
    
    perform actuary.logz(p_pack, p_proc, 'acomplished', 'step06', -777); 
    RAISE NOTICE '=== acomplished ===';    
   
END; --actuary.util_adm_obj_comm_apliki()
$body$ LANGUAGE plpgsql
/
COMMENT ON FUNCTION actuary.util_adm_obj_comm_apliki() IS '# Функция применения комментариев на объекты <<< util_adm_obj_comm_analizi, util_adm_obj_comm_apliki';
