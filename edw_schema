       rhfs.CATEGORY_ID,
       
       case when RHFs.IS_NEED_REINSURANCE::varchar = '1' then 'Е-Гарант и пул, в т. ч. ЮЛ'
       		when RHFs.CATEGORY_ID in ('OSAGOFL','OSAGO') and RHFs.NEW_REGIONNAME = 'Центральный офис'
            then case when RHFs.is_policy_from_e_garant::varchar = '1'                
