	drop view if exists cdm_analysis_out.ROL_HISTORY_FOR_SUM_EDW_FULL;
create or replace view  cdm_analysis_out.ROL_HISTORY_FOR_SUM_EDW_FULL as
select 
	   --rfs.is_main,
	   case when rfs.is_main::integer = 1 then 1
		    --when rfs.is_main = 0 and costtype_name in ('Неустойка', 'Расходы на правовую защиту') then 0
	        when rfs.is_main::integer = 0 and (costtype_name in ('Неустойка') or RFS.IS_SUIT::integer = 1 or RFS.REFUNDCATEGORY ='Выплата по удостоверению ФУ') then 0
		    else -1
	   end as is_main,		    
       tab_from,
       coalesce(rfs.DB, 'нд') as DB,
       rfs.REPORT_DATE, --date_trunc('month', CURRENT_DATE)::date - 1 as REPORT_DATE,
       claim_exposure_id::text as  claim_exposure_id, --RFC.GURU_EXPOSURE_ID,
       RFs.CLAIM_ID,
       RFS.MISSED_SUBJECT_ID,
       RFS.LOSS_ADJUSTMENT_ID,
       rfs. risk_object_id,   -- kms20241125
       
       ------ править сразу в 4х местах надо:
       coalesce(trim(substr(DICT7GS_ID,                1, 7)),   'нд') 	as DICT7GS_ID,
       coalesce(trim(substr(CATEGORY_ID,               1, 256)), 'нд') 	as CATEGORY_ID,
       coalesce(trim(substr(CATEGORY_ID_2020,          1, 256)), 'нд') 	as CATEGORY_ID_2020,
       coalesce(trim(substr(NEW_REGIONNAME,            1, 256)), 'нд')	as NEW_REGIONNAME,
       coalesce(trim(substr(RFs.PRODUCTCLASS,          1, 256)), 'нд')	as PRODUCTCLASS,
       coalesce(trim(substr(RFs.OBJECTCLASS,           1, 256)), 'нд') 	as OBJECTCLASS,
       coalesce(trim(substr(RFs.SALECHANNEL2008,       1, 10)),  'нд') 	as SALECHANNEL2008,
       coalesce(trim(substr(RFs.saleschennelname,      1, 150)), 'нд') 	as saleschennelname,
       coalesce(trim(substr(RFs.c_accounting_group_id, 1, 16)),  'нд') 	as c_accounting_group_id,
       ------      
       
       ------ править сразу в 3х местах надо:       
       coalesce(trim(substr(case when NEW_REGIONNAME = 'Республика Крым и Севастополь' and accidentdate::date < '2025-07-01'::date
                                 then 'Краснодарский край с Республикой Адыгея'
                                 else NEW_REGIONNAME
                            end,                       1, 256)), 'нд')	as NEW_REGIONNAME2025, 
       ------1
                            
       rfs.IS_CAPITAL_INSURANCE::integer,
       RFS.sale_channel_groupmk_name, 
       
       RFs.CLAIM_NUMBER,
       RFs.IS_AUTO_INTEGRATION::integer,
       trim(substr(RFs.DESCRIPTION, 1, 256)) as DESCRIPTION,
       RFS.policy_id,
       RFs.POLICY_SERIES,
       RFs.POLICY_NUMBER,
       rfs.CONTRACT_NUMBER,
       RFs.ACCIDENTDATE,
       to_char(RFs.ACCIDENTDATE::date, 'yyyymm') 				as ACCIDENTMONTH,


       ------ IS_POLICY_AUTHORIZED + LOSSDATE_minus_6months --- править  4х местах этого пакета -------
       case when lower(substr(CLAIM_ID::varchar, 1, 4)) = 'guru' and
      			 coalesce(lower(substr(POLICY_ID::varchar, 1, 4)), ' ') not in ('arm4', 'ekis', 'gwpc')
			then 0
            else 1
        end as IS_POLICY_AUTHORIZED,

       case when D1 is null or
                (
                 (
       			 lower(substr(CLAIM_ID::varchar, 1, 4)) = 'guru' and
      			 coalesce(lower(substr(POLICY_ID::varchar, 1, 4)), ' ') not in ('arm4', 'ekis', 'gwpc')
       			 )
                 and to_char(D1,'dd.mm')::varchar = '01.01') then ACCIDENTDATE - interval '6 month'
            when D1 is not null then D1
			else ACCIDENTDATE - interval '6 month'
        end as LOSSDATE_minus_6months,
	    -------------------------------------------------------------------------

       RFs.ACCEPTDATE,
       RFS.APPROVEDSUM as APPROVEDSUM, 
       RFS.RECORD_DATE,
---777 as ACT_CLOSURE_DATE,--RFc.ACT_CLOSURE_DATE,  -->> есть в RHFC
       RFS.INSERT_DATE,
       case when length (rfs.accident_quarter::integer::text)= 5 then RFS.ACCIDENT_QUARTER else null end ACCIDENT_QUARTER,
       RFS.DEVELOPMENT_QUARTER,
       to_char(RFS.RECORD_DATE, 'yyyyq') as APPROVED_QUARTER,

	   rfs.branch_char_id,
	   
	   RFS.IS_NEED_REINSURANCE::integer,
       RFS.IS_SUIT::integer,
       RFS.is_postingdate_null::integer,
       RFS.CORRECT_RECORD_DATE::date,
       null::integer IS_RECLASSIFICATION,
       rfs.IS_BEFORE_SUIT::integer, 
       null RE_SHARE,
       RFs.is_direct_payout_outgo::integer,
       CASE WHEN COALESCE(RFS.BANK_POSREDNIK,
                          RFS.LEASING_COMPANY_ID,
                          RFS.AUTO_DEALER_ID,
                          RFS.OTHER_PARTNER_ID) IS NOT NULL
            THEN 1
            ELSE 0
       END IS_PARTNER,
       rfs.is_policy_from_e_garant::integer,
       case when RFS.is_direct_payout_outgo::integer::text = '1' THEN 'ПВУ (Прямой)'
       		when RFS.IS_PVU::integer::text = '1' then 'ПВУ (Ответственный)'
       else 'Не ПВУ'
       end as IS_PVU,
       case when RFS.is_direct_payout_outgo::integer::text = '1' THEN '1'
       		when RFS.IS_PVU::integer::text = '1' then '1'
       else '0'
       end as IS_PVU_FLAG,       

       rfs.claim_currency,
