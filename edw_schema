CREATE FUNCTION actuary.guru_cur_rate (policy_currency integer, cur_date date)  RETURNS numeric
  VOLATILE
AS $body$
DECLARE
Coef NUMERIC;
Max_Cur_Date DATE;
BEGIN
  IF POLICY_CURRENCY = 10001 THEN
    Coef := 1;
  ELSE
    select max(CR.EFFECTIVEDATE) -- max(CR.EXPIREDATE)
    into Max_Cur_Date
    from ACTUARY.CC_CUR_RATES cr
    where CR.BASECURRENCY = POLICY_CURRENCY;
    select CR.CUR
    into Coef
    from ACTUARY.CC_CUR_RATES cr
    where CR.BASECURRENCY = POLICY_CURRENCY and
          CR.EFFECTIVEDATE = Max_Cur_Date;
       -- CUR_DATE between least(CR.EFFECTIVEDATE,Max_Cur_Date) and least(CR.EXPIREDATE,Max_Cur_Date);
  END IF;
  RETURN Coef; 
END
$body$ LANGUAGE plpgsql
/
COMMENT ON FUNCTION actuary.guru_cur_rate(integer, date) IS '# Курс валюты ГУРУ <<< guru';
