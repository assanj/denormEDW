              join VOSIPOV.CC_CLAIM_INCIDENT ci on CI.CLAIMID = CP.CLAIMID
              join VOSIPOV.CC_EXPOSURE_INCIDENT ei on EI.INCIDENTID = CI.INCIDENTID 
                   
