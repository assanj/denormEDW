       COALESCE(attr_exp.arm_ekis_contractoption, attr_inc.arm_ekis_contractoption, attr_clm.arm_ekis_contractoption,  'нд')        AS arm_ekis_contractoption,
       COALESCE(attr_exp.arm_ekis_is_partner, attr_inc.arm_ekis_is_partner, attr_clm.arm_ekis_is_partner,  'нд')                    AS arm_ekis_is_partner,
       COALESCE(attr_exp.salechannelfullname_de, attr_inc.salechannelfullname_de, attr_clm.salechannelfullname_de,  'нд')           AS salechannelfullname_de,
       COALESCE(ATTR_EXP.CATEGORY_ID_FINAL, ATTR_INC.CATEGORY_ID_FINAL_in, ATTR_CLM.CATEGORY_ID_FINAL_cl, 'нд')                     as CATEGORY_ID_FINAL,    
       COALESCE(ATTR_EXP.CATEGORY_ID_2020_FINAL, ATTR_INC.CATEGORY_ID_2020_FINAL_in, ATTR_CLM.CATEGORY_ID_2020_FINAL_cl, 'нд')     as CATEGORY_ID_2020_FINAL,    
       COALESCE(attr_exp.regionname_final, attr_inc.regionname_final, attr_clm.regionname_final,  'нд')                             AS regionname_final,
               
