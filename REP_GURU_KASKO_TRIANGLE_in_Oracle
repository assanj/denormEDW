LIB CONNECT TO 'Oracle_msk-m1-repsrv.rgs.ru_(actuary)';

NoConcatenate
[OSAGO_RESULT_FORM_ALL]:
SELECT
	DB,
	NEW_REGIONNAME,
	PROPERTYFORMNAME,
	SALECHANNELFULLNAME_DE,
    IS_DEAD_POLICY,
	YEAR_MONTH,
	YEAR_QUARTER,
	D1_QUARTER,
	IS_POLICY_FROM_E_GARANT,
	IS_POLICY_FROM_EA,
    IS_NEED_REINSURANCE,
	NEW_REGIONNAME_EXT,
	D1_MONTH,
	CONTRACTOPTION,
	OSAGO_CHAIN_NUMBER,
	KC,
	EXPOSURE,
	EP,
	WRITTENPREMIUM,
	POLICYCOUNT,
	RETURNPREMIUM
FROM ACTUARY.XLS_EXPOSISION_PREMIUM_OSAGO_O;

NoConcatenate
[ОСАГО_исх]:
Load
	DB as [База данных],
    NEW_REGIONNAME as [Регион],
    NEW_REGIONNAME_EXT as [Регион ОФР],
    PROPERTYFORMNAME as [Тип страхователя],
    IS_POLICY_FROM_EA,
    IS_POLICY_FROM_E_GARANT,
    IS_NEED_REINSURANCE,
   	SALECHANNELFULLNAME_DE as [Канал продаж],
    IS_DEAD_POLICY,
    if(CONTRACTOPTION='2','Возобновлённый', 'Первоначальный') as [Признак договора],
    if(PROPERTYFORMNAME='Физическое лицо',if(OSAGO_CHAIN_NUMBER>1,'Возобновлённый', 'Первоначальный'),if(CONTRACTOPTION='2','Возобновлённый', 'Первоначальный')) as [Признак пролонгации],
    KC,
    D1_QUARTER as [Квартал начала],
    D1_MONTH as [Месяц начала],
    YEAR_QUARTER as Квартал,
    YEAR_MONTH as Месяц, 
    EXPOSURE,
    EP,
    POLICYCOUNT,
    WRITTENPREMIUM,
    RETURNPREMIUM
Resident [OSAGO_RESULT_FORM_ALL];

drop table [OSAGO_RESULT_FORM_ALL];

/*
left join ([ОСАГО_исх])
LOAD
    KC,
    К_срок
FROM [lib://qfs_Actuary/Справочники для треугольников.xlsx](ooxml, embedded labels, table is К_срок);
*/
NoConcatenate
[ОСАГО]:
load *;
Load
	[База данных],
	[Регион],
    [Регион ОФР],
    [Тип страхователя],
    IS_POLICY_FROM_EA,
    IS_POLICY_FROM_E_GARANT,
    IS_NEED_REINSURANCE,
    IS_DEAD_POLICY,
    [Канал продаж],
    [Признак договора],
    [Признак пролонгации],
    [Квартал начала],
    [Месяц начала],
    Квартал,
    Месяц,
 //   sum(EXPOSURE) as Экспозиция,
 	if([Месяц] <= $(month),sum(EXPOSURE), 0) as Экспозиция,
    sum(EP) as [Заработанная премия],
    sum(POLICYCOUNT) as [Количество договоров],
 //   sum(POLICYCOUNT*if(isnull(К_срок),1,К_срок)) as [Количество полисолет],
 	sum(EXPOSURE) as [Количество полисолет],
    sum(WRITTENPREMIUM) as [Начисленная премия],
    sum(RETURNPREMIUM) as [Возвраты]
Resident [ОСАГО_исх]
group by 
	KC,
	[База данных],
	[Регион],
    [Регион ОФР],
    [Тип страхователя],
    IS_POLICY_FROM_EA,
    IS_POLICY_FROM_E_GARANT,
    IS_NEED_REINSURANCE,
    IS_DEAD_POLICY,
    [Канал продаж],
    [Признак договора],
    [Признак пролонгации],
    [Квартал начала],
    [Месяц начала],
    Квартал,
    Месяц;
  
drop Table [ОСАГО_исх];

left join (ОСАГО)
LOAD
    Регион,
    [Федеральный округ] as [Федеральный округ],
    [Флаг РСА-Агент] as [Флаг Токс_регион],
    [Регион крупный] as [Регион крупный]
FROM [lib://qfs_Actuary/Справочники для треугольников.xlsx]
(ooxml, embedded labels, table is Регионы);

NoConcatenate
Данные:
add load
	[Квартал начала],
    [Месяц начала],
    Квартал,
    Месяц,
    if ([Канал продаж]='грМК Партнер Онлайн' or [Канал продаж]='грМК Сайт' or [Канал продаж]='грМК Телемаркетинг' or IS_POLICY_FROM_E_GARANT='1',1,0) as [Флаг Е-ОСАГО],
    IS_NEED_REINSURANCE as [Передан в пул?],
    [Флаг Токс_регион],
    [Регион крупный],
    [Признак пролонгации],
    if([Тип страхователя]='Физическое лицо','ФЛ','ЮЛ') as [Тип страхователя],
    sum ([Заработанная премия]) as ЗП,
    sum([Экспозиция]) as Экспозиция,
    sum([Начисленная премия]) as НП,
    sum([Количество договоров]) as [Кол-во договоров]
 resident ОСАГО
 where isnull(IS_DEAD_POLICY) or IS_DEAD_POLICY=0 or IS_DEAD_POLICY=-1 
 group by 
 	[Квартал начала],
    [Месяц начала],
    Квартал,
    Месяц, 
    if ([Канал продаж]='грМК Партнер Онлайн' or [Канал продаж]='грМК Сайт' or [Канал продаж]='грМК Телемаркетинг' or IS_POLICY_FROM_E_GARANT='1',1,0),
    IS_NEED_REINSURANCE,
    [Флаг Токс_регион],
    [Регион крупный],
    [Признак пролонгации],
    if([Тип страхователя]='Физическое лицо','ФЛ','ЮЛ');
    
store [Данные] into [lib://qfs_Actuary/Выгрузки QS\ОСАГО ЗП и экспозиция 2026-07_усеченный_клик.csv] (txt, delimiter is ';'); 
