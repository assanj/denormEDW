       NEW_REGIONNAME,
       NEW_REGIONNAME_ext,
       PROPERTYFORMNAME,
       SALECHANNELFULLNAME_DE,
       IS_PARTNER,
       YEAR_MONTH,
       YEAR_QUARTER,
