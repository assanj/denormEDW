       YEAR_QUARTER,
       D1_QUARTER,
       IS_POLICY_FROM_E_GARANT,
       
       IS_POLICY_FROM_EA,
       NEW_REGIONNAME_EXT,
       D1_MONTH,
       CONTRACTOPTION,
       OSAGO_CHAIN_NUMBER,
       KC,
       IS_DEAD_POLICY,
       IS_NEED_REINSURANCE,
       
       is_prolongation,
       OWNER_REGISTRATION_REGION,
       
       sum(EXPOSURE) EXPOSURE,
       sum(EP) EP,
       sum(WRITTENPREMIUM) WRITTENPREMIUM,
       sum(POLICYCOUNT) POLICYCOUNT,
       sum(RETURNPREMIUM) RETURNPREMIUM
from
(
select /*+ parallel(orf 16) */

    --'gwpc' DB,
       substr(orf.objectid,1,4) as db, -- kms20260323: 4impl
       
       ORF.NEW_REGIONNAME,
       decode(ORF.PROPERTYFORMNAME, '1', 'Физическое лицо', '2', 'Юридическое лицо', '5', 'Юридическое лицо') PROPERTYFORMNAME,
