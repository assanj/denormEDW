WITH source AS (
  SELECT
    D1_QUARTER,
    D1_MONTH,
    YEAR_QUARTER,
    YEAR_MONTH,
    IS_NEED_REINSURANCE,
    EXPOSURE,
    EP,
    WRITTENPREMIUM,
    POLICYCOUNT,
    PROPERTYFORMNAME,
    OSAGO_CHAIN_NUMBER,
    CONTRACTOPTION,
    SALECHANNELFULLNAME_DE,
    IS_POLICY_FROM_E_GARANT,
    NEW_REGIONNAME AS REGION_NAME,
    IS_DEAD_POLICY
  FROM ACTUARY.XLS_EXPOSISION_PREMIUM_OSAGO_O
  WHERE (IS_DEAD_POLICY IS NULL OR IS_DEAD_POLICY = 0 OR IS_DEAD_POLICY = -1)
),
calc AS (
  SELECT
    D1_QUARTER,
    D1_MONTH,
    YEAR_QUARTER,
    YEAR_MONTH,
    IS_NEED_REINSURANCE,
    EXPOSURE,
    EP,
    WRITTENPREMIUM,
    POLICYCOUNT,
    REGION_NAME,
    -- Признак пролонгации
    CASE
      WHEN PROPERTYFORMNAME = 'Физическое лицо'
        THEN CASE WHEN OSAGO_CHAIN_NUMBER > 1 THEN 'Возобновлённый' ELSE 'Первоначальный' END
      ELSE CASE WHEN CONTRACTOPTION = '2' THEN 'Возобновлённый' ELSE 'Первоначальный' END
    END AS RENEWAL_FLAG,
    -- Тип страхователя (ФЛ/ЮЛ)
    CASE WHEN PROPERTYFORMNAME = 'Физическое лицо' THEN 'ФЛ' ELSE 'ЮЛ' END AS INSURED_TYPE,
    -- Флаг Е-ОСАГО
    CASE
      WHEN SALECHANNELFULLNAME_DE IN ('грМК Партнер Онлайн','грМК Сайт','грМК Телемаркетинг')
           OR IS_POLICY_FROM_E_GARANT = '1' THEN 1
      ELSE 0
    END AS E_OSAGO_FLAG
  FROM source
)
SELECT
  c.D1_QUARTER                       AS "Квартал начала",
  c.D1_MONTH                         AS "Месяц начала",
  c.YEAR_QUARTER                     AS "Квартал",
  c.YEAR_MONTH                       AS "Месяц",
  c.E_OSAGO_FLAG                     AS "Флаг Е-ОСАГО",
  c.IS_NEED_REINSURANCE              AS "Передан в пул?",
  r."Флаг РСА-Агент"                 AS "Флаг Токс_регион",    -- поле из справочника регионов
  r."Регион крупный"                 AS "Регион крупный",      -- поле из справочника регионов
  c.RENEWAL_FLAG                     AS "Признак пролонгации",
  c.INSURED_TYPE                     AS "Тип страхователя",
  SUM(c.EP)                          AS "ЗП",
  SUM(CASE WHEN c.YEAR_MONTH <= :month THEN c.EXPOSURE ELSE 0 END) AS "Экспозиция",
  SUM(c.WRITTENPREMIUM)              AS "НП",
  SUM(c.POLICYCOUNT)                 AS "Кол-во договоров"
FROM calc c
LEFT JOIN REGIONS_REF r ON c.REGION_NAME = r.Регион   -- замените на фактическое имя таблицы/представления
GROUP BY
  c.D1_QUARTER,
  c.D1_MONTH,
  c.YEAR_QUARTER,
  c.YEAR_MONTH,
  c.E_OSAGO_FLAG,
  c.IS_NEED_REINSURANCE,
  r."Флаг РСА-Агент",
  r."Регион крупный",
  c.RENEWAL_FLAG,
  c.INSURED_TYPE;
