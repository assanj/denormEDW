--3. Создание объединенной таблицы данных (аналог Данные в Qlik)
DROP TABLE IF EXISTS actuary.rep_osago_triangle_data;
CREATE TABLE actuary.rep_osago_triangle_data AS

-- Часть 1: Данные по премиям и экспозиции (аналог первого LOAD)
WITH premium_data AS (
    SELECT 
        "Месяц начала" as start_month,
        "Месяц" as year_month,
        "Канал продаж" as sale_channel,
        "Флаг Е-ОСАГО" as flag_e_osago,
        IS_POLICY_FROM_EA,
        IS_POLICY_FROM_E_GARANT,
        "Передан в пул?" as is_need_reinsurance,
        CASE WHEN IS_POLICY_FROM_EA = '1' OR IS_POLICY_FROM_E_GARANT = '1' THEN '1' ELSE '0' END as drums_rca,
        "Флаг Токс_регион" as flag_toks_region,
        "Регион" as region_name,
        "Регион ОФР" as region_ofr,
        "Регион крупный" as region_big,
        "Признак договора" as contract_type,
        "Признак пролонгации" as prolongation_type,
        "Тип страхователя" as insurer_type,
        "Заработанная премия" as earned_premium,
        "Экспозиция" as exposure,
        "Начисленная премия" as written_premium,
        "Количество договоров" as policy_count,
        "Количество полисолет" as policy_year_count,
        NULL::text as claim_type_big,
        NULL::numeric as loss_count,
        NULL::numeric as loss_sum,
        'premium' as data_source
    FROM actuary.rep_osago_ep_expo
    WHERE left("Месяц", 4)::int >= 2019
),
-- Часть 2: Данные по убыткам (аналог второго LOAD - Concatenate)
loss_data AS (
    SELECT 
        "Месяц начала" as start_month,
        "Месяц события" as year_month,
        "Канал продаж" as sale_channel,
        "Флаг Е-ОСАГО" as flag_e_osago,
        IS_POLICY_FROM_EA,
        IS_POLICY_FROM_E_GARANT,
        "Передан в пул?" as is_need_reinsurance,
        CASE WHEN IS_POLICY_FROM_EA = '1' OR IS_POLICY_FROM_E_GARANT = '1' THEN '1' ELSE '0' END as drums_rca,
        "Флаг Токс_регион" as flag_toks_region,
        "Регион" as region_name,
        "Регион ОФР" as region_ofr,
        "Регион крупный" as region_big,
        "Признак договора" as contract_type,
        "Признак пролонгации" as prolongation_type,
        "Тип страхователя" as insurer_type,
        NULL::numeric as earned_premium,
        NULL::numeric as exposure,
        NULL::numeric as written_premium,
        NULL::numeric as policy_count,
        NULL::numeric as policy_year_count,
        "Тип убытка крупный" as claim_type_big,
        "Количество убытков" as loss_count,
        "Сумма несудебных убытков" as loss_sum,
        'loss' as data_source
    FROM actuary.rep_osago_triangle
    WHERE left("Месяц события", 4)::int >= 2019
),
-- Объединение данных
combined_data AS (
    SELECT * FROM premium_data
    UNION ALL
    SELECT * FROM loss_data
),
-- Присоединение справочника Сегменты
with_segments AS (
    SELECT 
        c.*,
        s.Сегмент as segment
    FROM combined_data c
    LEFT JOIN actuary.ref_xls4triangles_segments s 
        ON c.insurer_type = s."Тип страхователя" 
        AND c.claim_type_big = s."Тип убытка крупный"
),
-- Присоединение справочника Коэффициенты (для развития)
with_coefficients AS (
    SELECT 
        w.*,
        k."Коэф_развития_1" as coeff_dev_1,
        k."Коэф_развития_2" as coeff_dev_2,
        k."Сдвиг" as shift
    FROM with_segments w
    LEFT JOIN actuary.ref_xls4triangles_coefficients k 
        ON w.segment = k."Сегмент" 
        AND w.year_month = k."Месяц"
        AND w.claim_type_big = k."Тип убытка крупный"
        AND w.insurer_type = k."Тип страхователя"
        AND w.prolongation_type = k."Признак пролонгации"
),
-- Присоединение справочника Кварталы (для дат и кварталов)
with_quarters AS (
    SELECT 
        w.*,
        q."Год" as year_num,
        q."Месяц" as month_num,
        q."Дата" as ds_date,
        q."Квартал" as quarter,
        q2."Квартал события" as start_quarter,
        q2."Год начала" as start_year,
        q2."Дата" as dn_date
    FROM with_coefficients w
    LEFT JOIN actuary.ref_xls4triangles_quarters q 
        ON w.year_month = q."Месяц события"
    LEFT JOIN actuary.ref_xls4triangles_quarters q2 
        ON w.start_month = q2."Месяц события"
),
-- Присоединение коэффициентов COVID-19
with_covid AS (
    SELECT 
        w.*,
        c."k_covid19_osago" as k_covid19_osago
    FROM with_quarters w
    LEFT JOIN actuary.ref_xls4triangles_covid c 
        ON w.year_month = c."Месяц_COVID19"
),
-- Расчет дополнительных полей
with_calculated AS (
    SELECT 
        *,
        EXTRACT(MONTH FROM ds_date)::int as calendar_month,
        -- Месяц действия (аналог rangemax((year(DS)-year(DN))*12+(month(DS)*1-month(DN)*1)+1,1))
        GREATEST(
            (EXTRACT(YEAR FROM ds_date) - EXTRACT(YEAR FROM dn_date)) * 12 
            + (EXTRACT(MONTH FROM ds_date) - EXTRACT(MONTH FROM dn_date)) + 1,
            1
        ) as action_month,
        -- Сдвиг_дн (аналог rangemax(...) + Сдвиг - 1)
        GREATEST(
            (EXTRACT(YEAR FROM ds_date) - EXTRACT(YEAR FROM dn_date)) * 12 
            + (EXTRACT(MONTH FROM ds_date) - EXTRACT(MONTH FROM dn_date)) + 1,
            1
        ) + COALESCE(shift::int, 0) - 1 as shift_day
    FROM with_covid
)
SELECT * FROM with_calculated;

--4. Присоединение коэффициентов K_risk и K_season (из справочника Коэффициенты)
-- Для [Месяц действия] - K_risk
DROP TABLE IF EXISTS actuary.rep_osago_triangle_data_risk;
CREATE TABLE actuary.rep_osago_triangle_data_risk AS
SELECT 
    t.*,
    k."K_risk" as k_risk
FROM actuary.rep_osago_triangle_data t
LEFT JOIN actuary.ref_xls4triangles_coefficients k 
    ON t.claim_type_big = k."Тип убытка крупный"
    AND t.insurer_type = k."Тип страхователя"
    AND t.prolongation_type = k."Признак пролонгации"
    AND t.action_month = k."Месяц_";

--5. Присоединение коэффициентов K_season (из справочника Коэффициенты)
-- Для [Месяц календарный] - K_season
DROP TABLE IF EXISTS actuary.rep_osago_triangle_data_season;
CREATE TABLE actuary.rep_osago_triangle_data_season AS
SELECT 
    t.*,
    k."K_season" as k_season
FROM actuary.rep_osago_triangle_data_risk t
LEFT JOIN actuary.ref_xls4triangles_coefficients k 
    ON t.claim_type_big = k."Тип убытка крупный"
    AND t.insurer_type = k."Тип страхователя"
    AND t.prolongation_type = k."Признак пролонгации"
    AND t.calendar_month = k."Месяц_";

--6. Присоединение коэффициентов K_risk_all и K_risk_ppvu (из справочника Коэф_ты)
-- Для [Месяц действия] - K_risk_all, K_risk_ppvu
DROP TABLE IF EXISTS actuary.rep_osago_triangle_data_risk_all;
CREATE TABLE actuary.rep_osago_triangle_data_risk_all AS
SELECT 
    t.*,
    k."K_risk_all" as k_risk_all,
    k."K_risk_ppvu" as k_risk_ppvu
FROM actuary.rep_osago_triangle_data_season t
LEFT JOIN actuary.ref_xls4triangles_coef_ts k 
    ON t.insurer_type = k."Тип страхователя"
    AND t.prolongation_type = k."Признак пролонгации"
    AND t.action_month = k."Месяц_";

--7. Присоединение коэффициентов K_season_all и K_season_ppvu (из справочника Коэф_ты)
-- Для [Месяц календарный] - K_season_all, K_season_ppvu
DROP TABLE IF EXISTS actuary.rep_osago_triangle_data_final;
CREATE TABLE actuary.rep_osago_triangle_data_final AS
SELECT 
    t.*,
    k."K_season_all" as k_season_all,
    k."K_season_ppvu" as k_season_ppvu
FROM actuary.rep_osago_triangle_data_risk_all t
LEFT JOIN actuary.ref_xls4triangles_coef_ts k 
    ON t.insurer_type = k."Тип страхователя"
    AND t.prolongation_type = k."Признак пролонгации"
    AND t.calendar_month = k."Месяц_";

--8. Создание итоговой таблицы результатов
DROP TABLE IF EXISTS actuary.rep_osago_ep_expo_triangle_result;
CREATE TABLE actuary.rep_osago_ep_expo_triangle_result AS
SELECT 
    current_timestamp as load_timestamp,
    session_user as load_user,
    p_report_date as report_date,
    *
FROM actuary.rep_osago_triangle_data_final;

-- Очистка временных таблиц
DROP TABLE IF EXISTS actuary.rep_osago_triangle_data;
DROP TABLE IF EXISTS actuary.rep_osago_triangle_data_risk;
DROP TABLE IF EXISTS actuary.rep_osago_triangle_data_season;
DROP TABLE IF EXISTS actuary.rep_osago_triangle_data_risk_all;
