       orf.NEW_REGIONNAME_EXT,
       orf.D1_MONTH,
       f1.CONTRACTOPTION,
       f1.OSAGO_CHAIN_NUMBER,
       f1.KC,
       f1.IS_DEAD_POLICY,
       f1.IS_NEED_REINSURANCE,
       
       f1.is_prolongation,
