         f1.IS_DEAD_POLICY,
         f1.IS_NEED_REINSURANCE,
         
         f1.is_prolongation,
         f1.OWNER_REGISTRATION_REGION         
                  
union all
select /*+ parallel(orf 16) */
       /*kms20062024:case when ORF.NEW_REGIONNAME like 'ТЭК%'
            then 'КС'
            else 'ЕКИС'
        end DB,*/
       'ЕКИС' as DB,
       ORF.NEW_REGIONNAME,
