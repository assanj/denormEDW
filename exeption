        execute immediate 'create or replace view OSAGO_st_FqRM1 as select * from  OSAGO_st_FoRM1';
        execute immediate 'create or replace view OSAGO_gw_FqRM1 as select * from  OSAGO_gw_FoRM1';
        
        execute immediate 'create or replace view OSAGO_RESULT_FqRM_ALL as select * from  OSAGO_RESULT_FORM_ALL';
        execute immediate 'create or replace view OSAGO_st_RESULT_FqRM_ALL as select * from  OSAGO_st_RESULT_FORM_ALL';
        execute immediate 'create or replace view OSAGO_gw_RESULT_FqRM_ALL as select * from  OSAGO_gw_RESULT_FORM_ALL';  
        
