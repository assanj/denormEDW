  v_scri varchar2(128) := 'YYYY-MM-DD - Экспозиция и ЗП по ОСАГО для Ольги.sql';  
  
begin
utils.logz(v_proc, v_scri, 'START');

execute immediate 'truncate table XLS_EXPOSISION_PREMIUM_OSAGO_O';

-- вставляем данные из ранее расчитанного агрегата по ОСАГО:

 -- IF v#END_DATE = trunc(sysdate, 'q') - 1 THEN
    if  trunc(sysdate,'MM')-1 = trunc(sysdate, 'q') - 1  then  
        
        execute immediate 'create or replace view OSAGO_FqRM1 as select * from  OSAGO_FoRM1_q';
        execute immediate 'create or replace view OSAGO_st_FqRM1 as select * from  OSAGO_st_FoRM1_q';
        execute immediate 'create or replace view OSAGO_gw_FqRM1 as select * from  OSAGO_gw_FoRM1_q';
        
        execute immediate 'create or replace view OSAGO_RESULT_FqRM_ALL as select * from  OSAGO_RESULT_FORM_ALL_Q';
        execute immediate 'create or replace view OSAGO_st_RESULT_FqRM_ALL as select * from  OSAGO_st_RESULT_FORM_ALL_q';
