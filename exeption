       sum(ORF.POLICYCOUNT) POLICYCOUNT,
       sum(ORF.RETURNPREMIUM) RETURNPREMIUM
from OSAGO_RESULT_FqRM_ALL orf
     left join osago_fqrm1 f1 on orf.objectid = f1.objectid-- kms24092020
     left join DICTSALECHANNELTYPE2008 ch on CH.SALE_CHANNEL_TYPE2008_ID = ORF.SALECHANNEL2008
--where 1 = 0     
group by ORF.NEW_REGIONNAME,
         decode(ORF.PROPERTYFORMNAME, '1', 'Физическое лицо', '2', 'Юридическое лицо', '5', 'Юридическое лицо'),
         CH.SALECHANNELFULLNAME_DE,
         to_char(ORF.T1, 'yyyymm'),
