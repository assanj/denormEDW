       sum(ORF.EP - ORF.RETURNPREMIUM) EP,
       sum(ORF.WRITTENPREMIUM) WRITTENPREMIUM,
       sum(ORF.POLICYCOUNT) POLICYCOUNT,
       sum(ORF.RETURNPREMIUM) RETURNPREMIUM
