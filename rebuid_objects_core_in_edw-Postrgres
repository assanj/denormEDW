-- Таблица для полных данных (аналог листа "DataFull")
-- Содержит все исходные данные с фильтрами
CREATE TABLE actuary.glm_data_full (
    "Отв_Пр" VARCHAR(20),            -- Тип страховщика: ОтвСтр/ПрСтр
    "Тип страхователя" VARCHAR(10),  -- Тип страхователя: ФЛ/ЮЛ
    "Тип договора" VARCHAR(20),      -- Тип договора: Первоначальный/Возобновлённый/ЕГП
    "Месяц действия" INTEGER,        -- Номер месяца действия (от 1 до 13)
    "Месяц календарный" INTEGER,     -- Номер календарного месяца (от 1 до 12)
    "MCL" NUMERIC,                   -- Убыток (Mean Claim Loss)
    "Exp" NUMERIC                    -- Экспозиция (объем)
);

-- Таблица для данных после фильтрации (аналог листа "Data")
-- Содержит данные для одного конкретного расчета
CREATE TABLE actuary.glm_data (
    "Месяц действия" INTEGER,        -- Номер месяца действия
    "Месяц календарный" INTEGER,     -- Номер календарного месяца
    "MCL" NUMERIC,                   -- Убыток
    "Exp" NUMERIC,                   -- Экспозиция
    PRIMARY KEY ("Месяц действия", "Месяц календарный")
);

-- Таблица для индексов (аналог листа "Ind")
-- Хранит результаты расчета Ind1 и Ind2
CREATE TABLE actuary.glm_ind (
    "Месяц действия" INTEGER,        -- Номер месяца действия
    "Ind 1" NUMERIC,                 -- Индекс по месяцам действия
    "Месяц календарный" INTEGER,     -- Номер календарного месяца
    "Ind 2" NUMERIC,                 -- Индекс по календарным месяцам
    "N1" INTEGER,                    -- Количество групп по месяцам действия
    "N2" INTEGER                     -- Количество групп по календарным месяцам
);

-- Таблица для результатов (аналог листа "Result")
-- Хранит коэффициенты K1, K2 и базовую частоту
CREATE TABLE actuary.glm_result (
    "Месяц действия" INTEGER,        -- Номер месяца действия
    "K1" NUMERIC,                    -- Коэффициент по месяцам действия
    "Месяц календарный" INTEGER,     -- Номер календарного месяца
    "K2" NUMERIC,                    -- Коэффициент по календарным месяцам
    "Базовая частота" NUMERIC DEFAULT 1  -- Базовая частота (всегда 1)
);

-- Таблица для сводных результатов (аналог листа "ResultFull")
-- Хранит все результаты расчетов по всем комбинациям фильтров
CREATE TABLE actuary.glm_result_full (
    "Группа" VARCHAR(50),            -- Группа: Ответственный страховщик / Прямой страховщик
    "Подгруппа" VARCHAR(50),         -- Подгруппа: ФЛ, Первоначальный и т.д.
    "Месяц действия" INTEGER,        -- Номер месяца действия
    "K1" NUMERIC,                    -- Коэффициент K1
    "Месяц календарный" INTEGER,     -- Номер календарного месяца
    "K2" NUMERIC,                    -- Коэффициент K2
    "Тип страховщика" VARCHAR(10),   -- ОтвСтр / ПрСтр
    "Тип страхователя" VARCHAR(10),  -- ФЛ / ЮЛ
    "Тип договора" VARCHAR(20)       -- Первоначальный / Возобновлённый / ЕГП
);

-- ========================================
-- 3. ФУНКЦИЯ РАСЧЕТА НОРМЫ (аналог Function norma)
-- ========================================
-- Назначение: вычисляет евклидову норму разности между текущими и предыдущими
-- значениями коэффициентов K1 и K2. Используется для проверки сходимости
-- итерационного алгоритма.
-- ========================================

CREATE OR REPLACE FUNCTION actuary.glm_norma(
    p_k1 NUMERIC[],      -- Текущие значения K1
    p_temp_k1 NUMERIC[], -- Предыдущие значения K1
    p_k2 NUMERIC[],      -- Текущие значения K2
    p_temp_k2 NUMERIC[], -- Предыдущие значения K2
    p_n1 INTEGER,        -- Количество элементов в K1
    p_n2 INTEGER         -- Количество элементов в K2
)
RETURNS NUMERIC AS $$
DECLARE
    v_s1 NUMERIC := 0;  -- Сумма квадратов разностей для K1
    v_s2 NUMERIC := 0;  -- Сумма квадратов разностей для K2
    v_i INTEGER;        -- Счетчик для цикла
BEGIN
    -- Проверка: если какой-либо массив NULL, возвращаем 1 (максимальная ошибка)
    IF p_k1 IS NULL OR p_temp_k1 IS NULL OR p_k2 IS NULL OR p_temp_k2 IS NULL THEN
        RETURN 1;
    END IF;
    
    -- Вычисляем сумму квадратов разностей для K1
    -- Формула: Σ(K1[i] - tempK1[i])²
    FOR v_i IN 1..p_n1 LOOP
        -- Проверяем, что индекс существует в обоих массивах
        IF v_i <= array_length(p_k1, 1) AND v_i <= array_length(p_temp_k1, 1) THEN
            v_s1 := v_s1 + (COALESCE(p_k1[v_i], 0) - COALESCE(p_temp_k1[v_i], 0)) ^ 2;
        END IF;
    END LOOP;
    
    -- Вычисляем сумму квадратов разностей для K2
    -- Формула: Σ(K2[j] - tempK2[j])²
    FOR v_i IN 1..p_n2 LOOP
        -- Проверяем, что индекс существует в обоих массивах
        IF v_i <= array_length(p_k2, 1) AND v_i <= array_length(p_temp_k2, 1) THEN
            v_s2 := v_s2 + (COALESCE(p_k2[v_i], 0) - COALESCE(p_temp_k2[v_i], 0)) ^ 2;
        END IF;
    END LOOP;
    
    -- Возвращаем корень из суммы квадратов (евклидова норма)
    -- Формула: √(s1 + s2)
    RETURN SQRT(v_s1 + v_s2);
END;
$$ LANGUAGE plpgsql;

-- ========================================
-- 4. ФУНКЦИЯ РАСЧЕТА ИНДЕКСОВ (аналог Sub Calc_Ind)
-- ========================================
-- Назначение: вычисляет индексы Ind1 (по месяцам действия) и Ind2 (по календарным месяцам)
-- Индексы показывают отношение фактического убытка к ожидаемому
-- ========================================

CREATE OR REPLACE FUNCTION actuary.glm_calc_ind()
RETURNS VOID AS $$
DECLARE
    v_n1 INTEGER;           -- Количество групп по месяцам действия
    v_n2 INTEGER;           -- Количество групп по календарным месяцам
    v_i INTEGER;            -- Счетчик для месяцев действия
    v_j INTEGER;            -- Счетчик для календарных месяцев
    v_sum_v NUMERIC;        -- Сумма экспозиции V
    v_sum_vz NUMERIC;       -- Сумма V * Z (взвешенный убыток)
    v_expected_z NUMERIC;   -- Ожидаемое значение Z
    v_action_month INTEGER; -- Текущий месяц действия
    v_calendar_month INTEGER; -- Текущий календарный месяц
    v_action_months INTEGER[]; -- Массив уникальных месяцев действия
    v_calendar_months INTEGER[]; -- Массив уникальных календарных месяцев
BEGIN
    -- ========================================
    -- Шаг 1: Получаем размерности и уникальные значения
    -- ========================================
    
    -- Собираем все уникальные месяцы действия в массив
    SELECT ARRAY_AGG(DISTINCT "Месяц действия" ORDER BY "Месяц действия")
    INTO v_action_months
    FROM actuary.glm_data;
    
    -- Собираем все уникальные календарные месяцы в массив
    SELECT ARRAY_AGG(DISTINCT "Месяц календарный" ORDER BY "Месяц календарный")
    INTO v_calendar_months
    FROM actuary.glm_data;
    
    -- Определяем количество групп
    v_n1 := COALESCE(array_length(v_action_months, 1), 0);
    v_n2 := COALESCE(array_length(v_calendar_months, 1), 0);
    
    -- Проверка наличия данных
    IF v_n1 = 0 OR v_n2 = 0 THEN
        RAISE NOTICE 'Нет данных для расчета индексов';
        RETURN;
    END IF;
    
    -- Сохраняем N1 и N2 в таблицу Ind (как в Excel)
    INSERT INTO actuary.glm_ind ("N1", "N2") VALUES (v_n1, v_n2);
    
    -- ========================================
    -- Шаг 2: Создаем временную матрицу с нормированным убытком Z = S / V
    -- ========================================
    
    DROP TABLE IF EXISTS temp_matrix;
    CREATE TEMP TABLE temp_matrix AS
    SELECT 
        "Месяц действия",
        "Месяц календарный",
        "Exp" AS v,                    -- Экспозиция (объем)
        "MCL" AS s,                    -- Убыток
        CASE 
            WHEN "Exp" > 0 THEN "MCL" / "Exp"  -- Нормированный убыток
            ELSE 0 
        END AS z
    FROM actuary.glm_data;
    
    -- Создаем индексы для ускорения запросов
    CREATE INDEX idx_tm_action ON temp_matrix ("Месяц действия");
    CREATE INDEX idx_tm_calendar ON temp_matrix ("Месяц календарный");
    
    -- ========================================
    -- Шаг 3: Расчет Ind1 (индексы по месяцам действия)
    -- ========================================
    -- Алгоритм:
    -- 1. V_i_plus = Σ V (сумма V по строке)
    -- 2. Z_i_plus = Σ(V*Z) / ΣV (средневзвешенное Z по строке)
    -- 3. Z_i = Σ(V * Z_plus_i) / ΣV (ожидаемое Z)
    -- 4. Ind1 = Z_i_plus / Z_i
    -- ========================================
    
    DROP TABLE IF EXISTS temp_ind1;
    CREATE TEMP TABLE temp_ind1 (
        "Месяц действия" INTEGER,
        "Ind1" NUMERIC
    );
    
    -- Цикл по каждому месяцу действия
    FOR v_i IN 1..v_n1 LOOP
        v_action_month := v_action_months[v_i];
        
        -- 3.1: Вычисляем V_i_plus = сумма V по строке (для данного месяца действия)
        SELECT COALESCE(SUM(v), 0) INTO v_sum_v
        FROM temp_matrix
        WHERE "Месяц действия" = v_action_month;
        
        -- 3.2: Вычисляем Z_i_plus = (сумма V * Z) / (сумма V) по строке
        -- Это средневзвешенное Z для данного месяца действия
        SELECT 
            CASE 
                WHEN COALESCE(SUM(v), 0) > 0 THEN SUM(v * z) / SUM(v)
                ELSE 0
            END INTO v_sum_vz
        FROM temp_matrix
        WHERE "Месяц действия" = v_action_month;
        
        -- 3.3: Вычисляем Z_i = сумма(V * Z_plus_i) / сумма(V)
        -- где Z_plus_i - средневзвешенное Z по столбцам (календарным месяцам)
        WITH col_avg AS (
            -- Для каждого календарного месяца вычисляем средневзвешенное Z по столбцу
            SELECT 
                "Месяц календарный",
                SUM(v) AS v_sum,
                CASE 
                    WHEN SUM(v) > 0 THEN SUM(v * z) / SUM(v)
                    ELSE 0
                END AS z_plus_i
            FROM temp_matrix
            GROUP BY "Месяц календарный"
        )
        SELECT 
            CASE 
                WHEN v_sum_v > 0 THEN SUM(tm.v * ca.z_plus_i) / v_sum_v
                ELSE 0
            END INTO v_expected_z
        FROM temp_matrix tm
        JOIN col_avg ca ON tm."Месяц календарный" = ca."Месяц календарный"
        WHERE tm."Месяц действия" = v_action_month;
        
        -- 3.4: Вычисляем Ind1 = Z_i_plus / Z_i
        INSERT INTO temp_ind1 ("Месяц действия", "Ind1")
        VALUES (
            v_action_month,
            CASE 
                WHEN v_expected_z > 0 THEN v_sum_vz / v_expected_z
                ELSE 0
            END
        );
    END LOOP;
    
    -- Сохраняем результаты Ind1 в таблицу
    INSERT INTO actuary.glm_ind ("Месяц действия", "Ind 1")
    SELECT "Месяц действия", "Ind1"
    FROM temp_ind1
    ORDER BY "Месяц действия";
    
    -- ========================================
    -- Шаг 4: Расчет Ind2 (индексы по календарным месяцам)
    -- ========================================
    -- Алгоритм аналогичен Ind1, но с перестановкой измерений:
    -- 1. V_i_plus = Σ V (сумма V по столбцу)
    -- 2. Z_i_plus = Σ(V*Z) / ΣV (средневзвешенное Z по столбцу)
    -- 3. Z_i = Σ(V * Z_plus_i) / ΣV (ожидаемое Z)
    -- 4. Ind2 = Z_i_plus / Z_i
    -- ========================================
    
    DROP TABLE IF EXISTS temp_ind2;
    CREATE TEMP TABLE temp_ind2 (
        "Месяц календарный" INTEGER,
        "Ind2" NUMERIC
    );
    
    -- Цикл по каждому календарному месяцу
    FOR v_j IN 1..v_n2 LOOP
        v_calendar_month := v_calendar_months[v_j];
        
        -- 4.1: Вычисляем V_i_plus = сумма V по столбцу (для данного календарного месяца)
        SELECT COALESCE(SUM(v), 0) INTO v_sum_v
        FROM temp_matrix
        WHERE "Месяц календарный" = v_calendar_month;
        
        -- 4.2: Вычисляем Z_i_plus = (сумма V * Z) / (сумма V) по столбцу
        SELECT 
            CASE 
                WHEN COALESCE(SUM(v), 0) > 0 THEN SUM(v * z) / SUM(v)
                ELSE 0
            END INTO v_sum_vz
        FROM temp_matrix
        WHERE "Месяц календарный" = v_calendar_month;
        
        -- 4.3: Вычисляем Z_i = сумма(V * Z_plus_i) / сумма(V)
        -- где Z_plus_i - средневзвешенное Z по строкам (месяцам действия)
        WITH row_avg AS (
            -- Для каждого месяца действия вычисляем средневзвешенное Z по строке
            SELECT 
                "Месяц действия",
                SUM(v) AS v_sum,
                CASE 
                    WHEN SUM(v) > 0 THEN SUM(v * z) / SUM(v)
                    ELSE 0
                END AS z_plus_i
            FROM temp_matrix
            GROUP BY "Месяц действия"
        )
        SELECT 
            CASE 
                WHEN v_sum_v > 0 THEN SUM(tm.v * ra.z_plus_i) / v_sum_v
                ELSE 0
            END INTO v_expected_z
        FROM temp_matrix tm
        JOIN row_avg ra ON tm."Месяц действия" = ra."Месяц действия"
        WHERE tm."Месяц календарный" = v_calendar_month;
        
        -- 4.4: Вычисляем Ind2 = Z_i_plus / Z_i
        INSERT INTO temp_ind2 ("Месяц календарный", "Ind2")
        VALUES (
            v_calendar_month,
            CASE 
                WHEN v_expected_z > 0 THEN v_sum_vz / v_expected_z
                ELSE 0
            END
        );
    END LOOP;
    
    -- Сохраняем результаты Ind2 в таблицу
    INSERT INTO actuary.glm_ind ("Месяц календарный", "Ind 2")
    SELECT "Месяц календарный", "Ind2"
    FROM temp_ind2
    ORDER BY "Месяц календарный";
    
    -- ========================================
    -- Шаг 5: Очистка временных таблиц
    -- ========================================
    
    DROP TABLE IF EXISTS temp_matrix;
    DROP TABLE IF EXISTS temp_ind1;
    DROP TABLE IF EXISTS temp_ind2;
    
    RAISE NOTICE 'Расчет индексов завершен. N1=%, N2=%', v_n1, v_n2;
END;
$$ LANGUAGE plpgsql;

-- ========================================
-- 5. ОСНОВНАЯ ФУНКЦИЯ РАСЧЕТА (аналог Sub Расчет)
-- ========================================
-- Назначение: вычисляет коэффициенты K1 и K2 методом максимального правдоподобия
-- Используется итеративный алгоритм до достижения заданной точности
-- ========================================

CREATE OR REPLACE FUNCTION actuary.glm_calc_main()
RETURNS VOID AS $$
DECLARE
    v_n1 INTEGER;            -- Количество групп по месяцам действия
    v_n2 INTEGER;            -- Количество групп по календарным месяцам
    v_eps NUMERIC := 0.000001; -- Допустимая ошибка (критерий прекращения итераций)
    v_dist NUMERIC := 1;     -- Текущая ошибка (норма разности)
    v_iter INTEGER := 0;     -- Счетчик итераций
    v_max_iter INTEGER := 10000; -- Максимальное число итераций (защита от зацикливания)
    v_i INTEGER;             -- Счетчик для месяцев действия
    v_j INTEGER;             -- Счетчик для календарных месяцев
    v_s1 NUMERIC;            -- Сумма S / K2 (для расчета K1) или S / K1 (для расчета K2)
    v_s2 NUMERIC;            -- Сумма V
    v_k1_prev NUMERIC[];     -- Массив предыдущих значений K1
    v_k2_prev NUMERIC[];     -- Массив предыдущих значений K2
    v_k1_curr NUMERIC[];     -- Массив текущих значений K1
    v_k2_curr NUMERIC[];     -- Массив текущих значений K2
    v_action_months INTEGER[]; -- Массив уникальных месяцев действия
    v_calendar_months INTEGER[]; -- Массив уникальных календарных месяцев
    v_action_month INTEGER;  -- Текущий месяц действия
    v_calendar_month INTEGER; -- Текущий календарный месяц
BEGIN
    -- ========================================
    -- Шаг 1: Получаем размерности и уникальные значения
    -- ========================================
    
    -- Собираем все уникальные месяцы действия в массив
    SELECT ARRAY_AGG(DISTINCT "Месяц действия" ORDER BY "Месяц действия")
    INTO v_action_months
    FROM actuary.glm_data;
    
    -- Собираем все уникальные календарные месяцы в массив
    SELECT ARRAY_AGG(DISTINCT "Месяц календарный" ORDER BY "Месяц календарный")
    INTO v_calendar_months
    FROM actuary.glm_data;
    
    -- Определяем количество групп
    v_n1 := COALESCE(array_length(v_action_months, 1), 0);
    v_n2 := COALESCE(array_length(v_calendar_months, 1), 0);
    
    -- Проверка наличия данных
    IF v_n1 = 0 OR v_n2 = 0 THEN
        RAISE NOTICE 'Нет данных для расчета';
        RETURN;
    END IF;
    
    -- ========================================
    -- Шаг 2: Создаем временную матрицу данных
    -- ========================================
    
    DROP TABLE IF EXISTS temp_matrix;
    CREATE TEMP TABLE temp_matrix AS
    SELECT 
        "Месяц действия",
        "Месяц календарный",
        "Exp" AS v,    -- Экспозиция
        "MCL" AS s     -- Убыток
    FROM actuary.glm_data;
    
    -- Создаем индексы для ускорения запросов
    CREATE INDEX idx_tm_action ON temp_matrix ("Месяц действия");
    CREATE INDEX idx_tm_calendar ON temp_matrix ("Месяц календарный");
    
    -- ========================================
    -- Шаг 3: Инициализация массивов
    -- ========================================
    
    -- Начальные значения K1 = 1 (как в Excel)
    v_k1_prev := array_fill(1, ARRAY[v_n1]);
    v_k1_curr := array_fill(1, ARRAY[v_n1]);
    
    -- Начальные значения K2 = 1 (как в Excel)
    v_k2_prev := array_fill(1, ARRAY[v_n2]);
    v_k2_curr := array_fill(1, ARRAY[v_n2]);
    
    -- ========================================
    -- Шаг 4: Итеративный алгоритм максимального правдоподобия
    -- ========================================
    -- Алгоритм:
    -- 1. K1[i] = Σ(S[i,j] / K2[j]) / Σ(V[i,j])
    -- 2. K2[j] = Σ(S[i,j] / K1[i]) / Σ(V[i,j])
    -- 3. Повторять до сходимости (dist < eps)
    -- ========================================
    
    RAISE NOTICE 'Начинаем итеративный расчет (N1=%, N2=%)...', v_n1, v_n2;
    
    -- Основной цикл итераций
    WHILE v_dist > v_eps AND v_iter < v_max_iter LOOP
        v_iter := v_iter + 1;
        
        -- ========================================
        -- 4.1: Обновляем K1 (по месяцам действия)
        -- ========================================
        -- Формула: K1[i] = Σ(S[i,j] / K2[j]) / Σ(V[i,j])
        -- где i - месяц действия, j - календарный месяц
        -- ========================================
        
        FOR v_i IN 1..v_n1 LOOP
            v_action_month := v_action_months[v_i];
            v_s1 := 0; -- Обнуляем сумму S/K2
            v_s2 := 0; -- Обнуляем сумму V
            
            -- Суммируем по всем календарным месяцам
            FOR v_j IN 1..v_n2 LOOP
                v_calendar_month := v_calendar_months[v_j];
                
                -- Вычисляем суммы для данной комбинации месяца действия и календарного месяца
                SELECT 
                    COALESCE(SUM(s / v_k2_curr[v_j]), 0), -- Сумма S / K2
                    COALESCE(SUM(v), 0)                   -- Сумма V
                INTO v_s1, v_s2
                FROM temp_matrix
                WHERE "Месяц действия" = v_action_month
                  AND "Месяц календарный" = v_calendar_month;
            END LOOP;
            
            -- Вычисляем K1[i] = сумма(S/K2) / сумма(V)
            IF v_s2 > 0 THEN
                v_k1_curr[v_i] := v_s1 / v_s2;
            ELSE
                v_k1_curr[v_i] := 0; -- Защита от деления на ноль
            END IF;
        END LOOP;
        
        -- ========================================
        -- 4.2: Обновляем K2 (по календарным месяцам)
        -- ========================================
        -- Формула: K2[j] = Σ(S[i,j] / K1[i]) / Σ(V[i,j])
        -- где i - месяц действия, j - календарный месяц
        -- ========================================
        
        FOR v_j IN 1..v_n2 LOOP
            v_calendar_month := v_calendar_months[v_j];
            v_s1 := 0; -- Обнуляем сумму S/K1
            v_s2 := 0; -- Обнуляем сумму V
            
            -- Суммируем по всем месяцам действия
            FOR v_i IN 1..v_n1 LOOP
                v_action_month := v_action_months[v_i];
                
                -- Вычисляем суммы для данной комбинации
                SELECT 
                    COALESCE(SUM(s / v_k1_curr[v_i]), 0), -- Сумма S / K1
                    COALESCE(SUM(v), 0)                   -- Сумма V
                INTO v_s1, v_s2
                FROM temp_matrix
                WHERE "Месяц действия" = v_action_month
                  AND "Месяц календарный" = v_calendar_month;
            END LOOP;
            
            -- Вычисляем K2[j] = сумма(S/K1) / сумма(V)
            IF v_s2 > 0 THEN
                v_k2_curr[v_j] := v_s1 / v_s2;
            ELSE
                v_k2_curr[v_j] := 0; -- Защита от деления на ноль
            END IF;
        END LOOP;
        
        -- ========================================
        -- 4.3: Вычисляем норму ошибки
        -- ========================================
        -- Формула: dist = √(Σ(K1[i] - prevK1[i])² + Σ(K2[j] - prevK2[j])²)
        -- ========================================
        
        v_dist := actuary.glm_norma(
            v_k1_curr, v_k1_prev,
            v_k2_curr, v_k2_prev,
            v_n1, v_n2
        );
        
        -- ========================================
        -- 4.4: Обновляем предыдущие значения
        -- ========================================
        
        v_k1_prev := v_k1_curr;
        v_k2_prev := v_k2_curr;
        
        -- Выводим прогресс каждые 100 итераций (для отладки)
        IF v_iter % 100 = 0 THEN
            RAISE NOTICE 'Итерация %, ошибка: %', v_iter, v_dist;
        END IF;
    END LOOP;
    
    -- Выводим информацию о завершении итераций
    RAISE NOTICE 'Расчет завершен. Итераций: %, ошибка: %', v_iter, v_dist;
    
    -- ========================================
    -- Шаг 5: Сохраняем результаты
    -- ========================================
    
    -- Сохраняем K1 по месяцам действия (как в Excel)
    FOR v_i IN 1..v_n1 LOOP
        INSERT INTO actuary.glm_result ("Месяц действия", "K1")
        VALUES (v_action_months[v_i], v_k1_curr[v_i]);
    END LOOP;
    
    -- Сохраняем K2 по календарным месяцам (как в Excel)
    FOR v_j IN 1..v_n2 LOOP
        INSERT INTO actuary.glm_result ("Месяц календарный", "K2")
        VALUES (v_calendar_months[v_j], v_k2_curr[v_j]);
    END LOOP;
    
    -- Устанавливаем базовую частоту = 1 (как в Excel)
    UPDATE actuary.glm_result SET "Базовая частота" = 1;
    
    -- ========================================
    -- Шаг 6: Очистка временных таблиц
    -- ========================================
    
    DROP TABLE IF EXISTS temp_matrix;
    
    RAISE NOTICE 'Результаты сохранены.';
END;
$$ LANGUAGE plpgsql;

-- ========================================
-- 6. ФУНКЦИЯ ДЛЯ МАССОВОГО РАСЧЕТА (аналог Sub Расчет_по_всем)
-- ========================================
-- Назначение: выполняет расчет для всех 12 комбинаций фильтров:
-- - 2 типа страховщиков (ОтвСтр, ПрСтр)
-- - 2 типа страхователей (ФЛ, ЮЛ)
-- - 3 типа договоров (Первоначальный, Возобновлённый, ЕГП)
-- ========================================

CREATE OR REPLACE FUNCTION actuary.glm_calc_all()
RETURNS VOID AS $$
DECLARE
    -- Массивы для хранения комбинаций фильтров (как в Excel макросах)
    v_insurers VARCHAR[] := ARRAY['ОтвСтр', 'ПрСтр'];     -- Типы страховщиков
    v_clients VARCHAR[] := ARRAY['ФЛ', 'ЮЛ'];            -- Типы страхователей
    v_contracts VARCHAR[] := ARRAY['Первоначальный', 'Возобновлённый', 'ЕГП']; -- Типы договоров
    v_i INTEGER;           -- Счетчик по страховщикам
    v_j INTEGER;           -- Счетчик по страхователям
    v_k INTEGER;           -- Счетчик по договорам
    v_group VARCHAR(50);   -- Название группы (для ResultFull)
    v_subgroup VARCHAR(50); -- Название подгруппы (для ResultFull)
    v_insurer_type VARCHAR(10);   -- Текущий тип страховщика
    v_client_type VARCHAR(10);    -- Текущий тип страхователя
    v_contract_type VARCHAR(20);  -- Текущий тип договора
    v_count INTEGER := 0;   -- Счетчик обработанных комбинаций
    v_start_time TIMESTAMP; -- Время начала расчетов
    v_end_time TIMESTAMP;   -- Время окончания расчетов
BEGIN
    -- Запоминаем время начала
    v_start_time := clock_timestamp();
    
    -- Очищаем таблицу результатов перед расчетами
    TRUNCATE TABLE actuary.glm_result_full;
    
    RAISE NOTICE 'Начинаем массовый расчет...';
    RAISE NOTICE 'Всего комбинаций: %', array_length(v_insurers, 1) * array_length(v_clients, 1) * array_length(v_contracts, 1);
    
    -- ========================================
    -- Цикл по типам страховщиков (ОтвСтр / ПрСтр)
    -- ========================================
    
    FOR v_i IN 1..array_length(v_insurers, 1) LOOP
        v_insurer_type := v_insurers[v_i];
        
        -- Определяем название группы для ResultFull (как в Excel)
        IF v_insurer_type = 'ОтвСтр' THEN
            v_group := 'Ответственный страховщик';
        ELSE
            v_group := 'Прямой страховщик';
        END IF;
        
        -- ========================================
        -- Цикл по типам страхователей (ФЛ / ЮЛ)
        -- ========================================
        
        FOR v_j IN 1..array_length(v_clients, 1) LOOP
            v_client_type := v_clients[v_j];
            
            -- ========================================
            -- Цикл по типам договоров
            -- ========================================
            
            FOR v_k IN 1..array_length(v_contracts, 1) LOOP
                v_contract_type := v_contracts[v_k];
                
                -- Формируем название подгруппы (как в Excel)
                v_subgroup := v_client_type || ', ' || v_contract_type;
                v_count := v_count + 1;
                
                RAISE NOTICE '--- Расчет %: % / % / % ---', v_count, v_insurer_type, v_client_type, v_contract_type;
                
                -- ========================================
                -- Шаг 1: Копируем отфильтрованные данные в glm_data
                -- ========================================
                -- Аналог Excel: фильтр и копирование из DataFull в Data
                -- ========================================
                
                -- Очищаем таблицу данных для нового расчета
                TRUNCATE TABLE actuary.glm_data;
                
                -- Копируем данные с фильтрацией по трем полям
                INSERT INTO actuary.glm_data ("Месяц действия", "Месяц календарный", "MCL", "Exp")
                SELECT 
                    "Месяц действия",
                    "Месяц календарный",
                    "MCL",
                    "Exp"
                FROM actuary.glm_data_full
                WHERE "Отв_Пр" = v_insurer_type
                  AND "Тип страхователя" = v_client_type
                  AND "Тип договора" = v_contract_type
                ORDER BY "Месяц действия", "Месяц календарный";
                
                -- Проверяем, есть ли данные для этой комбинации
                IF NOT EXISTS (SELECT 1 FROM actuary.glm_data) THEN
                    RAISE NOTICE 'Нет данных для комбинации %, пропускаем...', v_subgroup;
                    CONTINUE;
                END IF;
                
                -- ========================================
                -- Шаг 2: Расчет индексов
                -- ========================================
                -- Аналог Excel: вызов Sub Calc_Ind
                -- ========================================
                
                RAISE NOTICE '  Расчет индексов...';
                TRUNCATE TABLE actuary.glm_ind;
                PERFORM actuary.glm_calc_ind();
                
                -- ========================================
                -- Шаг 3: Основной расчет
                -- ========================================
                -- Аналог Excel: вызов Sub Расчет
                -- ========================================
                
                RAISE NOTICE '  Основной расчет...';
                TRUNCATE TABLE actuary.glm_result;
                PERFORM actuary.glm_calc_main();
                
                -- ========================================
                -- Шаг 4: Сохранение результатов в ResultFull
                -- ========================================
                -- Аналог Excel: копирование из Result в ResultFull
                -- ========================================
                
                RAISE NOTICE '  Сохранение результатов...';
                
                -- Сохраняем K1 (по месяцам действия)
                INSERT INTO actuary.glm_result_full (
                    "Группа",           -- Ответственный страховщик / Прямой страховщик
                    "Подгруппа",        -- ФЛ, Первоначальный и т.д.
                    "Месяц действия",   -- Номер месяца действия
                    "K1",               -- Коэффициент K1
                    "Тип страховщика",  -- ОтвСтр / ПрСтр
                    "Тип страхователя", -- ФЛ / ЮЛ
                    "Тип договора"      -- Первоначальный / Возобновлённый / ЕГП
                )
                SELECT 
                    v_group,
                    v_subgroup,
                    r."Месяц действия",
                    r."K1",
                    v_insurer_type,
                    v_client_type,
                    v_contract_type
                FROM actuary.glm_result r
                WHERE r."Месяц действия" IS NOT NULL
                ORDER BY r."Месяц действия";
                
                -- Сохраняем K2 (по календарным месяцам)
                INSERT INTO actuary.glm_result_full (
                    "Группа",
                    "Подгруппа",
                    "Месяц календарный",
                    "K2",
                    "Тип страховщика",
                    "Тип страхователя",
                    "Тип договора"
                )
                SELECT 
                    v_group,
                    v_subgroup,
                    r."Месяц календарный",
                    r."K2",
                    v_insurer_type,
                    v_client_type,
                    v_contract_type
                FROM actuary.glm_result r
                WHERE r."Месяц календарный" IS NOT NULL
                ORDER BY r."Месяц календарный";
                
                RAISE NOTICE '  Расчет для % завершен.', v_subgroup;
            END LOOP;
        END LOOP;
    END LOOP;
    
    -- Запоминаем время окончания
    v_end_time := clock_timestamp();
    
    -- Выводим итоговую статистику
    RAISE NOTICE '========================================';
    RAISE NOTICE 'Все расчеты завершены.';
    RAISE NOTICE 'Обработано комбинаций: %', v_count;
    RAISE NOTICE 'Время выполнения: %', v_end_time - v_start_time;
    RAISE NOTICE '========================================';
END;
$$ LANGUAGE plpgsql;

-- ========================================
-- 7. ГЛАВНАЯ ФУНКЦИЯ ЗАПУСКА (аналог запуска макроса)
-- ========================================

CREATE OR REPLACE FUNCTION actuary.glm_run_all()
RETURNS TEXT AS $$
DECLARE
    v_start_time TIMESTAMP; -- Время начала
    v_end_time TIMESTAMP;   -- Время окончания
    v_duration INTERVAL;    -- Длительность выполнения
BEGIN
    -- Запоминаем время начала
    v_start_time := clock_timestamp();
    
    -- Выводим информацию о начале расчетов
    RAISE NOTICE '========================================';
    RAISE NOTICE 'Начало расчетов: %', v_start_time;
    RAISE NOTICE '========================================';
    
    -- Запускаем массовый расчет
    PERFORM actuary.glm_calc_all();
    
    -- Запоминаем время окончания
    v_end_time := clock_timestamp();
    v_duration := v_end_time - v_start_time;
    
    -- Выводим итоговую информацию
    RAISE NOTICE '========================================';
    RAISE NOTICE 'Расчеты завершены: %', v_end_time;
    RAISE NOTICE 'Общее время выполнения: %', v_duration;
    RAISE NOTICE '========================================';
    
    -- Возвращаем результат
    RETURN 'Расчеты успешно завершены за ' || v_duration;
END;
$$ LANGUAGE plpgsql;

-- ========================================
-- 8. ФУНКЦИЯ ОЧИСТКИ ДАННЫХ
-- ========================================

CREATE OR REPLACE FUNCTION actuary.glm_cleanup()
RETURNS VOID AS $$
BEGIN
    -- Очищаем таблицы с данными (кроме исходных)
    TRUNCATE TABLE actuary.glm_data;
    TRUNCATE TABLE actuary.glm_ind;
    TRUNCATE TABLE actuary.glm_result;
    TRUNCATE TABLE actuary.glm_result_full;
    
    -- Удаляем временные таблицы, если они существуют
    DROP TABLE IF EXISTS temp_matrix;
    DROP TABLE IF EXISTS temp_ind1;
    DROP TABLE IF EXISTS temp_ind2;
    
    RAISE NOTICE 'Все временные таблицы очищены';
END;
$$ LANGUAGE plpgsql;

