                INTO v_s1, v_s2
                FROM temp_matrix
                WHERE "Месяц действия" = v_action_month
                  AND "Месяц календарный" = v_calendar_month;
            END LOOP;
            
            -- K2 = сумма(S/K1) / сумма(V)
            IF v_s2 > 0 THEN
                v_k2_curr[v_j] := v_s1 / v_s2;
            ELSE
                v_k2_curr[v_j] := 0;
            END IF;
        END LOOP;
        
        -- 4.3: Вычисляем норму ошибки
        v_dist := actuary.glm_norma(
            v_k1_curr, v_k1_prev,
            v_k2_curr, v_k2_prev,
            v_n1, v_n2
        );
        
        -- 4.4: Обновляем предыдущие значения
        v_k1_prev := v_k1_curr;
        v_k2_prev := v_k2_curr;
        
        -- Выводим прогресс каждые 100 итераций
        IF v_iter % 100 = 0 THEN
