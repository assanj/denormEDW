DO $$
DECLARE
    rec RECORD;
    search_value TEXT := 'ваш_текст_для_поиска';  -- замените на нужное значение
    schema_name TEXT := 'core';                   -- замените на нужную схему
    query_text TEXT;
    found_count INTEGER;
    result_count INTEGER := 0;
BEGIN
    -- Перебираем все текстовые поля в схеме
    FOR rec IN 
        SELECT 
            table_name,
            column_name,
            data_type
        FROM information_schema.columns
        WHERE table_schema = schema_name
          AND data_type IN ('character varying', 'varchar', 'text', 'char', 'character')
          AND character_maximum_length > 25  -- только поля длиннее 25 символов
        ORDER BY table_name, column_name
    LOOP
        -- Формируем динамический запрос для поиска
        query_text := format('
            SELECT COUNT(*) 
            FROM %I.%I 
            WHERE %I::TEXT LIKE ''%%%s%%''
        ', schema_name, rec.table_name, rec.column_name, search_value);
        
        -- Выполняем запрос
        EXECUTE query_text INTO found_count;
        
        -- Если найдены совпадения, выводим информацию
        IF found_count > 0 THEN
            RAISE NOTICE 'Таблица: %.%, Колонка: %, Найдено: % записей', 
                schema_name, rec.table_name, rec.column_name, found_count;
            result_count := result_count + 1;
        END IF;
        
    END LOOP;
    
    RAISE NOTICE 'Всего найдено таблиц/колонок с совпадениями: %', result_count;
END $$;
